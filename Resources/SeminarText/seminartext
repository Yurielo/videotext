    else:
        record = {
            "source_id": sid,
            "type": record_type,
            "file": rel,
            "title": src.stem
        }
        data["documents"].append(record)
        print(f"[OK] {sid} {record_type}")

    added.append(record)
    save_registry()
    print(f"     {rel}")

registry_path.write_text(
    json.dumps(data, ensure_ascii=False, indent=2) + "\n",
