def tc_to_seconds(tc):
    tc = tc.replace(",", ".")
    h, m, s = tc.split(":")
    return int(h) * 3600 + int(m) * 60 + float(s)

def seconds_to_tc(value):
    ms = round(value * 1000)
    h = ms // 3600000
    ms %= 3600000
    m = ms // 60000
    ms %= 60000
    s = ms // 1000
    ms %= 1000
    return f"{h:02d}:{m:02d}:{s:02d}.{ms:03d}"

def parse_srt(path):
    text = path.read_text(encoding="utf-8", errors="replace")
    blocks = re.split(r"\n\s*\n", text.strip())
    segments = []

    for block in blocks:
        lines = [x.strip() for x in block.splitlines() if x.strip()]
        if not lines:
            continue

        time_index = next((i for i, line in enumerate(lines) if "-->" in line), None)
        if time_index is None:
            continue

        left, right = [x.strip() for x in lines[time_index].split("-->", 1)]

        start = tc_to_seconds(left)
        end = tc_to_seconds(right)

        content = " ".join(lines[time_index + 1:]).strip()

        if not content:
            continue

        segments.append({
            "id": len(segments) + 1,
            "start": round(start, 3),
            "end": round(end, 3),
            "start_tc": seconds_to_tc(start),
            "end_tc": seconds_to_tc(end),
            "text": content
        })

