for sid in video_items:
    video_items[sid].sort(
        key=lambda x: (
            x.get("locator", {}).get("start", 0),
            x.get("locator", {}).get("segment", 0),
        )
    )

videos = sorted(
    sources.get("videos", []),
    key=lambda x: x.get("order", 999999)
)

all_topics = []
global_number = 1

for video in videos:
    sid = video.get("source_id")
    p = project / "topics" / f"{sid}_topics.json"

    if not p.is_file():
        continue

    data = json.loads(p.read_text(encoding="utf-8"))
    topics = data.get("topics", [])
    evidence = video_items.get(sid, [])

    for local_index, topic in enumerate(topics, start=1):
        start_sec = float(topic.get("start_seconds", 0))
        end_sec = float(topic.get("end_seconds", 0))

        matched = []
        for ev in evidence:
            loc = ev.get("locator", {})
            ev_start = float(loc.get("start", 0))
            ev_end = float(loc.get("end", 0))

            if ev_end <= start_sec:
                continue
            if ev_start >= end_sec:
                break

            matched.append(ev["evidence_id"])

        record = {
            "topic_id": f"topic_{global_number:04d}",
            "number": global_number,
            "source_id": sid,
            "source_order": video.get("order"),
            "local_number": local_index,
            "title": topic.get("title", ""),
            "summary": topic.get("summary", ""),
            "start": topic.get("start"),
            "end": topic.get("end"),
            "start_seconds": start_sec,
            "end_seconds": end_sec,
            "start_segment_id": topic.get("start_segment_id"),
            "evidence": {
                "first": matched[0] if matched else None,
                "last": matched[-1] if matched else None,
                "count": len(matched),
            },
        }

        all_topics.append(record)
        global_number += 1

result = {
    "schema_version": 1,
    "project": project.name,
    "detail": detail,
    "model": model,
    "topic_count": len(all_topics),
    "topics": all_topics,
}

out = project / "topics" / "seminar_topics.json"
out.write_text(
    json.dumps(result, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8"
)

print(f"Тем всего: {len(all_topics)}")
print(f"SEMINAR TOPICS: {out}")
PYMERGE

  echo
  echo "ГОТОВО: project-topics"
}

