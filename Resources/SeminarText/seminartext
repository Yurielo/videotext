      --model)
        shift
        [[ $# -gt 0 ]] || { echo "Ошибка: после --model требуется имя модели." >&2; return 2; }
        model="$1"
        ;;
      --force)
        force_arg="--force"
        ;;
      -h|--help)
        topics_command --help
        return 0
        ;;
      *)
        echo "Ошибка: неизвестный параметр topics: $1" >&2
        return 2
        ;;
    esac
    shift
  done

  command -v ollama >/dev/null 2>&1 || { echo "Ошибка: ollama не найден." >&2; return 1; }
  local topics_module
  topics_module="$(resolve_runtime_module topics)" || return 1

  local -a args=(
    "$topics_module"
    "$input"
    --root "$TRANSCRIPTS_ROOT"
    --detail "$detail"
    --model "$model"
