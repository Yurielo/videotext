import json
import sys
from pathlib import Path
from urllib.parse import urlparse

registry = Path(sys.argv[1])
source_id = sys.argv[2]
url = sys.argv[3].strip()

try:
    host = (urlparse(url).hostname or "").lower()
except Exception:
    host = ""

valid = (
    host == "youtu.be"
    or host == "youtube.com"
    or host.endswith(".youtube.com")
)

if not valid:
    raise SystemExit(f"Ошибка: URL не похож на YouTube: {url}")

data = json.loads(registry.read_text(encoding="utf-8"))

videos = data.get("videos", [])

target = None
for item in videos:
    if item.get("source_id") == source_id:
        target = item
        break

if target is None:
    raise SystemExit(f"Ошибка: source_id не найден: {source_id}")

mirrors = target.setdefault("mirrors", [])

for mirror in mirrors:
    if mirror.get("type") == "youtube" and mirror.get("url") == url:
        print(f"[SKIP] Ссылка уже привязана к {source_id}")
        raise SystemExit(0)

mirrors.append({
    "type": "youtube",
    "url": url
})

registry.write_text(
    json.dumps(data, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8"
)

print(f"[OK] YouTube привязан к {source_id}")
print(f"     {url}")
PYLINK
}

