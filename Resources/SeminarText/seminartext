publish_structured_timing_manifest() {
  local stage="$1" ledger="$2" source_reference="$3" source_type="$4" media="$5" language="$6" mode="$7" model="$8" vad_model="$9" chunk_seconds="${10}"
  python3 - "$stage" "$ledger" "$source_reference" "$source_type" "$media" "$language" "$mode" "$model" "$vad_model" "$chunk_seconds" "$VERSION" <<'PYTIMING'
import hashlib
import json
import sys
from pathlib import Path

stage = Path(sys.argv[1])
ledger = Path(sys.argv[2])
source_reference = sys.argv[3]
source_type = sys.argv[4]
media = Path(sys.argv[5])
language = sys.argv[6]
mode = sys.argv[7]
model = Path(sys.argv[8])
vad_model = Path(sys.argv[9])
chunk_seconds = int(sys.argv[10])
version = sys.argv[11]


def sha256_file(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def sha256_text(value):
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def artifact(part_id, extension):
    relative = f"parts/{part_id}.{extension}"
    path = stage / relative
    return {"path": relative, "sha256": sha256_file(path)}


def selected_timing_range(part_id):
    """Return the local envelope of all published JSON-full and SRT timing.

    `absolute_range` deliberately describes the prepared audio chunk. Whisper's
    VAD/timestamp padding can legitimately make selected evidence extend beyond
    that chunk duration, so its envelope is published separately rather than
    clipping or rewriting the selected artifacts.
    """
    ends = []
    starts = []

    def collect_offsets(value):
        if isinstance(value, dict):
            offsets = value.get("offsets")
            if isinstance(offsets, dict):
                start = offsets.get("from")
                end = offsets.get("to")
                if isinstance(start, (int, float)):
                    starts.append(float(start) / 1000.0)
                if isinstance(end, (int, float)):
                    ends.append(float(end) / 1000.0)
            for nested in value.values():
                collect_offsets(nested)
        elif isinstance(value, list):
            for nested in value:
                collect_offsets(nested)

    collect_offsets(json.loads((stage / "parts" / f"{part_id}.json").read_text(encoding="utf-8")))
    srt = (stage / "parts" / f"{part_id}.srt").read_text(encoding="utf-8")
    for start, end in __import__("re").findall(
        r"(\d{2}:\d{2}:\d{2},\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2},\d{3})", srt
    ):
        def seconds(value):
            hours, minutes, remainder = value.split(":")
            whole, millis = remainder.split(",")
            return int(hours) * 3600 + int(minutes) * 60 + int(whole) + int(millis) / 1000
        starts.append(seconds(start))
        ends.append(seconds(end))

    if not starts and not ends:
        return None
    if not starts or not ends:
        raise SystemExit(f"selected timing artifact for {part_id} has incomplete timestamps")
    return {"start_seconds": round(min(starts), 6), "end_seconds": round(max(ends), 6)}


parts = []
for line in ledger.read_text(encoding="utf-8").splitlines():
    if not line.strip():
        continue
    index, offset, duration, selected_attempt, part_id = line.split("\t")
    start = float(offset)
    end = start + float(duration)
    txt_path = stage / "parts" / f"{part_id}.txt"
    local_selected_range = selected_timing_range(part_id)
    selected_absolute_range = None
    if local_selected_range is not None:
        selected_absolute_range = {
            "start_seconds": round(start + local_selected_range["start_seconds"], 6),
            "end_seconds": round(start + local_selected_range["end_seconds"], 6),
        }
    parts.append(
        {
            "id": part_id,
            "order": int(index),
            "absolute_offset_seconds": round(start, 6),
            "absolute_range": {
                "start_seconds": round(start, 6),
                "end_seconds": round(end, 6),
            },
            "selected_timing_absolute_range": selected_absolute_range,
            "selected_attempt": selected_attempt,
            "speech_detected": txt_path.stat().st_size > 0,
            "artifacts": {
                "txt": artifact(part_id, "txt"),
                "srt": artifact(part_id, "srt"),
                "json_full": artifact(part_id, "json"),
            },
        }
    )

if [part["order"] for part in parts] != list(range(len(parts))):
    raise SystemExit("structured timing parts are not contiguous and ordered")

document = {
    "schema_version": 1,
    "artifact_type": "seminartext.selected_whisper_timing",
    "seminartext_version": version,
    "source": {
        "type": source_type,
        "reference": source_reference,
        "reference_sha256": sha256_text(source_reference),
        "media_sha256": sha256_file(media),
    },
    "transcription": {
        "language": language,
        "mode": mode,
        "chunk_seconds": chunk_seconds,
        "whisper_model": {
            "path": str(model.resolve()),
            "sha256": sha256_file(model),
        },
        "vad_model": {
            "path": str(vad_model.resolve()),
            "sha256": sha256_file(vad_model),
        },
    },
    "parts": parts,
}
(stage / "manifest.json").write_text(
    json.dumps(document, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PYTIMING
}

process_record() {
  local input="$1" requested="$2" source_type="${3:-файл}"
  local name="" dir="" wav="" raw="" clean="" review="" srt="" docx="" log="" info="" marker="" transcript_number="" quality_message=""
  local timing_dir="" timing_stage="" timing_ledger=""
  local media_input="$input" youtube_media=""
  name="$(sanitize_name "$requested")"
  dir="$(choose_output_dir "$name" "$input")"
  marker="$dir/.seminartext_complete"

  if [[ -f "$marker" && "$FORCE" -eq 0 ]]; then
    echo "Пропущено (уже готово): $(basename "$dir")"
    return 0
  fi

  mkdir -p "$dir"
  printf '%s' "$input" > "$dir/.source_path"
  if (( PROJECT_MODE == 1 )); then
    transcript_number=""
  else
    transcript_number="$(get_or_assign_transcript_number "$dir")"
  fi

  wav="$dir/.temporary_audio.wav"

  if (( PROJECT_MODE == 1 )); then
    raw="$dir/transcript.txt"
    clean="$dir/transcript_clean.txt"
    review="$dir/transcript_review.txt"
    srt="$dir/transcript.srt"
    docx="$dir/transcript.docx"
  else
    raw="$dir/transcript${transcript_number}.txt"
    clean="$dir/transcript_clean${transcript_number}.txt"
    review="$dir/transcript_review${transcript_number}.txt"
    srt="$dir/transcript${transcript_number}.srt"
    docx="$dir/transcript${transcript_number}.docx"
  fi
  log="$dir/transcription.log"
  info="$dir/info.txt"
  local chunks="$dir/.chunks" parts="$dir/.parts"
  local chunk_seconds="${SEMINARTEXT_CHUNK_SECONDS:-300}"
  if (( PROJECT_MODE == 1 )); then
    timing_dir="$dir/structured_timing"
  else
    timing_dir="$dir/structured_timing${transcript_number}"
  fi
  timing_stage="$parts/selected_timing"
  timing_ledger="$parts/selected_timing.tsv"

  cleanup_temp() {
    [[ -n "${wav:-}" ]] && rm -f "$wav"
    [[ -n "${youtube_media:-}" ]] && rm -f "$youtube_media"
    [[ -n "${chunks:-}" ]] && rm -rf "$chunks"
    [[ -n "${parts:-}" ]] && rm -rf "$parts"
  }
  trap cleanup_temp RETURN INT TERM

  echo
  echo "=================================================="
  echo "Запись: $(basename "$dir")"
  echo "Источник: $input"
  echo "Тип источника: $source_type"
  echo "Результаты: $dir"
  : > "$log"

  if [[ "$source_type" == "YouTube" ]] || is_youtube_url "$input"; then
    youtube_media="$(download_youtube_audio "$input" "$dir" "$log")" || return 1
    media_input="$youtube_media"
  fi
  rm -f "$marker" "$raw" "$clean" "$review" "$srt" "$docx"
  rm -rf "$timing_dir"
  mkdir -p "$chunks" "$parts"
  if (( STRUCTURED_TIMING == 1 )); then
    mkdir -p "$timing_stage"
    : > "$timing_ledger"
  fi

  echo "1/5 Подготавливаю аудио..."
  ffmpeg -nostdin -hide_banner -loglevel error -stats -y -i "$media_input" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$wav"

  echo "2/5 Разбиваю запись на фрагменты по $((chunk_seconds/60)) мин..."
  ffmpeg -nostdin -hide_banner -loglevel error -y -i "$wav" -f segment -segment_time "$chunk_seconds" -reset_timestamps 1 -c:a pcm_s16le "$chunks/chunk_%04d.wav"

  echo "3/5 Распознаю речь по фрагментам..."
  local idx=0 bad=0 piece prefix offset_ms piece_duration selected_attempt
  shopt -s nullglob
  local chunk_files=("$chunks"/chunk_*.wav)
  shopt -u nullglob
  ((${#chunk_files[@]} > 0)) || { echo "Ошибка: не удалось разбить аудио." >&2; return 1; }

  for piece in "${chunk_files[@]}"; do
    prefix="$parts/part_$(printf '%04d' "$idx")"
    selected_attempt="initial"
    echo "--- Фрагмент $((idx+1)) из ${#chunk_files[@]} ---" | tee -a "$log"
    if ! run_whisper_piece "$piece" "$prefix" "$log" 0; then
      echo "Первичная попытка завершилась ошибкой; повторяю фрагмент." | tee -a "$log"
      run_whisper_piece "$piece" "$prefix" "$log" 1 || { echo "Ошибка Whisper на фрагменте $((idx+1))." >&2; return 1; }
      selected_attempt="retry"
    fi
    # Полностью тихий фрагмент является нормальной частью записи.
    # Whisper + VAD при отсутствии речи создаёт пустой TXT.
    if [[ ! -s "$prefix.txt" ]]; then
      echo "Фрагмент $((idx+1)): речь не обнаружена — пропускаю как тишину." | tee -a "$log"
      if (( STRUCTURED_TIMING == 1 )); then
        piece_duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$piece")"
        retain_selected_timing_part "$prefix" "$timing_stage" "$idx" "$((idx * chunk_seconds))" "$piece_duration" "$selected_attempt" "$timing_ledger" || return 1
      fi
      ((idx+=1))
      continue
    fi

    if ! quality_message="$(quality_check "$prefix.txt" 2>&1)"; then
      [[ -z "$quality_message" ]] || printf '%s\n' "$quality_message" | tee -a "$log"
      echo "Обнаружено возможное зацикливание; повторяю с защитными параметрами." | tee -a "$log"
      cp -f "$prefix.txt" "$prefix.first.txt" 2>/dev/null || true
      run_whisper_piece "$piece" "$prefix" "$log" 1 || true
      selected_attempt="retry"
      if ! quality_message="$(quality_check "$prefix.txt" 2>&1)"; then
        [[ -z "$quality_message" ]] || printf '%s\n' "$quality_message" | tee -a "$log"
        echo "ПРЕДУПРЕЖДЕНИЕ: фрагмент $((idx+1)) остаётся подозрительным." | tee -a "$log"
        ((bad+=1))
      else
        echo "Повторная расшифровка фрагмента успешна." | tee -a "$log"
      fi
    fi
    [[ -s "$prefix.txt" ]] || { echo "Ошибка: пустой текст фрагмента $((idx+1))." >&2; return 1; }
    cat "$prefix.txt" >> "$raw"
    printf '\n\n' >> "$raw"
    offset_ms=$((idx * chunk_seconds * 1000))
    merge_srt_with_offset "$prefix.srt" "$offset_ms" "$srt"
    if (( STRUCTURED_TIMING == 1 )); then
      piece_duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$piece")"
      retain_selected_timing_part "$prefix" "$timing_stage" "$idx" "$((idx * chunk_seconds))" "$piece_duration" "$selected_attempt" "$timing_ledger" || return 1
    fi
    ((idx+=1))
  done

  echo "4/5 Очищаю и проверяю текст..."
  clean_text "$raw" "$clean" "$review" "$SOURCE_LANGUAGE"
  [[ -s "$clean" ]] || { echo "Ошибка: очищенный текст пуст." >&2; return 1; }
  if (( bad > 0 )); then
    printf '\nПРЕДУПРЕЖДЕНИЕ: %d фрагмент(а/ов) требуют ручной проверки по аудио. См. transcription.log.\n' "$bad" >> "$review"
  fi

  echo "5/5 Создаю DOCX..."
  if command -v pandoc >/dev/null 2>&1; then
    if ! pandoc "$clean" -f markdown -t docx -o "$docx" --metadata title="$(basename "$dir")"; then
      echo "Предупреждение: DOCX создать не удалось, остальные файлы сохранены." >&2
      rm -f "$docx"
    fi
  fi

  if (( STRUCTURED_TIMING == 1 )); then
    publish_structured_timing_manifest \
      "$timing_stage" "$timing_ledger" "$input" "$source_type" "$media_input" \
      "$SOURCE_LANGUAGE" "$MODE" "$MODEL" "$VAD_MODEL" "$chunk_seconds"
    mv "$timing_stage" "$timing_dir"
  fi

  {
    echo "SEMINARTEXT $VERSION PRO"
    echo "Название: $(basename "$dir")"
    echo "Источник: $input"
    echo "Тип источника: $source_type"
    echo "Идентификатор: $(source_key "$input")"
    if (( PROJECT_MODE == 1 )); then
      echo "Source ID: ${PROJECT_SOURCE_ID:-project}"
    else
      echo "Номер расшифровки: $transcript_number"
    fi
    echo "Режим: $MODE"
    echo "Язык источника: $SOURCE_LANGUAGE"
    echo "Дата: $(date '+%d.%m.%Y %H:%M')"
    echo "Модель: $MODEL"
    echo "VAD: $VAD_MODEL"
    echo "Размер фрагмента: ${chunk_seconds} сек."
    echo "Количество фрагментов: $idx"
    echo "Подозрительных фрагментов: $bad"
    if (( STRUCTURED_TIMING == 1 )); then
      echo "Structured timing: $(basename "$timing_dir")/manifest.json"
    fi
    if (( PROJECT_MODE == 1 )); then
      echo "Файлы: transcript.txt, transcript_clean.txt, transcript_review.txt, transcript.srt$( [[ -f "$docx" ]] && printf ', transcript.docx' )"
    else
      echo "Файлы: transcript${transcript_number}.txt, transcript_clean${transcript_number}.txt, transcript_review${transcript_number}.txt, transcript${transcript_number}.srt$( [[ -f "$docx" ]] && printf ', transcript%s.docx' "$transcript_number" )"
    fi
  } > "$info"

  touch "$marker"
  cleanup_temp
  trap - RETURN INT TERM
  echo "ГОТОВО: $clean"
  if (( bad > 0 )); then
    if (( PROJECT_MODE == 1 )); then
      echo "Внимание: проверьте transcript_review.txt и transcription.log."
    else
      echo "Внимание: проверьте transcript_review${transcript_number}.txt и transcription.log."
    fi
  fi
}


topics_command() {
  local input="" detail="auto" model="${SEMINARTEXT_TOPICS_MODEL:-gemma3:4b}"
  local force_arg=""

  if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'TOPICSHELP'
Использование:
  seminartext topics файл.mp4
  seminartext topics файл.mp4 --detail low
  seminartext topics файл.mp4 --detail high
  seminartext topics файл.mp4 --force

Описание:
  Анализирует существующий SRT через локальный Ollama.
  Whisper повторно не запускается.
  Границы тем выбираются только по реальным SRT-сегментам.

Детализация:
  low   крупные главы
  auto  естественная детализация (по умолчанию)
  high  подробные смысловые блоки

Результаты:
  topics.txt
  topics.md
  topics.json

Параметры:
  --detail low|auto|high
  --model MODEL
  --force
  -h, --help
TOPICSHELP
    return 0
  fi

  input="$1"
  shift

  while (($#)); do
    case "$1" in
      --detail)
        shift
        [[ $# -gt 0 ]] || { echo "Ошибка: после --detail требуется low, auto или high." >&2; return 2; }
        detail="$1"
        [[ "$detail" =~ ^(low|auto|high)$ ]] || { echo "Ошибка: --detail = low|auto|high" >&2; return 2; }
