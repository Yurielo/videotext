#!/bin/bash
set -Eeuo pipefail

SEMINARTEXT_ENTRYPOINT="${BASH_SOURCE[0]}"
while [[ -L "$SEMINARTEXT_ENTRYPOINT" ]]; do
  SEMINARTEXT_ENTRYPOINT_DIR="$(cd -P "$(dirname "$SEMINARTEXT_ENTRYPOINT")" >/dev/null 2>&1 && pwd)"
  SEMINARTEXT_ENTRYPOINT="$(readlink "$SEMINARTEXT_ENTRYPOINT")"
  [[ "$SEMINARTEXT_ENTRYPOINT" == /* ]] \
    || SEMINARTEXT_ENTRYPOINT="$SEMINARTEXT_ENTRYPOINT_DIR/$SEMINARTEXT_ENTRYPOINT"
done
SEMINARTEXT_ENTRYPOINT_DIR="$(cd -P "$(dirname "$SEMINARTEXT_ENTRYPOINT")" >/dev/null 2>&1 && pwd)"
SEMINARTEXT_ENTRYPOINT="$SEMINARTEXT_ENTRYPOINT_DIR/$(basename "$SEMINARTEXT_ENTRYPOINT")"
# A supervisor owns all queue/subtitle/tool scratch, independently of local traps.
SEMINARTEXT_TMP_HELPER="$SEMINARTEXT_ENTRYPOINT_DIR/seminartext_modules/owned_tmp.py"
[[ -f "$SEMINARTEXT_TMP_HELPER" ]] || { echo "Missing owned TMP lifecycle helper" >&2; exit 1; }
if ! python3 "$SEMINARTEXT_TMP_HELPER" --check; then
  exec python3 "$SEMINARTEXT_TMP_HELPER" -- /bin/bash "$SEMINARTEXT_ENTRYPOINT" "$@"
fi
SEMINARTEXT_VERSION_FILE="${SEMINARTEXT_VERSION_FILE:-$SEMINARTEXT_ENTRYPOINT_DIR/SEMINARTEXT_VERSION}"
[[ -f "$SEMINARTEXT_VERSION_FILE" ]] || {
  echo "Ошибка: не найден authoritative version-файл: $SEMINARTEXT_VERSION_FILE" >&2
  exit 1
}
VERSION="$(tr -d '[:space:]' < "$SEMINARTEXT_VERSION_FILE")"
[[ "$VERSION" =~ ^4\.[0-9]+\.[0-9]+$ ]] || {
  echo "Ошибка: некорректная версия SeminarText: $VERSION" >&2
  exit 1
}
TRANSCRIPTS_ROOT="${SEMINARTEXT_OUTPUT:-$HOME/Documents/Расшифровки}"
MODEL="${SEMINARTEXT_MODEL:-}"
VAD_MODEL="${SEMINARTEXT_VAD_MODEL:-}"
SEMINARTEXT_PYTHON="${SEMINARTEXT_PYTHON:-$HOME/.seminartext-venv/bin/python}"
MODE="normal"
SOURCE_LANGUAGE="ru"
STRUCTURED_TIMING=0
FORCE=0
LIST_ONLY=0
OPEN_RESULTS=1
INPUTS=()

# Automated runs must never trigger macOS GUI applications. Interactive shell
# use keeps the historical auto-open behavior unless the user passes --no-open.
if [[ "${SEMINARTEXT_HEADLESS:-}" == "1" \
   || -n "${CI:-}" \
   || -n "${PYTEST_CURRENT_TEST:-}" \
   || -n "${CODEX_HOME:-}" ]]; then
  OPEN_RESULTS=0
fi

PROJECT_MODE=0
PROJECT_OUTPUT_DIR=""
PROJECT_SOURCE_ID=""

PROMPT="Семинар на русском языке. Целостное Метоисцеление, кинезиология, прикладная кинезиология, Биологическое Центрирование, иглорефлексотерапия, акупунктура, меридиан, мышечное тестирование, психосоматика, метафизика, каббала, кли, масах, клипот, сфирот, Новолуние, Полнолуние."

sha256_file() {
  local file="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  else
    echo "Ошибка: для runtime-диагностики требуется shasum или sha256sum." >&2
    return 1
  fi
}

resolve_runtime_module() {
  local kind="$1" override_name filename label override candidate
  case "$kind" in
    topics)
      override_name="SEMINARTEXT_TOPICS_MODULE"
      filename="seminartext_topics.py"
      label="Topic Engine"
      ;;
    translate)
      override_name="SEMINARTEXT_TRANSLATE_MODULE"
      filename="seminartext_translate.py"
      label="Translate"
      ;;
    dataset_governance)
      override_name="SEMINARTEXT_DATASET_GOVERNANCE_MODULE"
      filename="dataset_governance.py"
      label="Dataset Governance"
      ;;
    *)
      echo "Ошибка: неизвестный runtime-модуль: $kind" >&2
      return 2
      ;;
  esac

  override="${!override_name:-}"
  if [[ -n "$override" ]]; then
    override="${override/#\~/$HOME}"
    if [[ -f "$override" ]]; then
      printf '%s\n' "$override"
      return 0
    fi
    echo "Ошибка: $override_name указывает на отсутствующий $label-модуль:" >&2
    echo "  $override" >&2
    echo "Исправьте путь или удалите $override_name, чтобы использовать bundled-модуль." >&2
    return 1
  fi

  for candidate in \
    "$SEMINARTEXT_ENTRYPOINT_DIR/seminartext_modules/$filename" \
    "$SEMINARTEXT_ENTRYPOINT_DIR/$filename"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  echo "Ошибка: не найден $label-модуль $filename." >&2
  echo "Проверены пути:" >&2
  echo "  $SEMINARTEXT_ENTRYPOINT_DIR/seminartext_modules/$filename" >&2
  echo "  $SEMINARTEXT_ENTRYPOINT_DIR/$filename" >&2
  echo "Задайте $override_name=/полный/путь/$filename или установите bundled-модуль рядом с CLI." >&2
  return 1
}

runtime_identity() {
  local topics_module translate_module dataset_governance_module
  topics_module="$(resolve_runtime_module topics)" || return 1
  translate_module="$(resolve_runtime_module translate)" || return 1
  dataset_governance_module="$(resolve_runtime_module dataset_governance)" || return 1

  echo "SeminarText runtime identity"
  echo "version=$VERSION"
  echo "cli.path=$SEMINARTEXT_ENTRYPOINT"
  echo "cli.sha256=$(sha256_file "$SEMINARTEXT_ENTRYPOINT")"
  echo "topics.path=$topics_module"
  echo "topics.sha256=$(sha256_file "$topics_module")"
  echo "topics.engine_id=legacy_ollama_gemma_runtime"
  echo "topics.role_id=production_legacy"
  echo "topics.production_runtime=true"
  echo "topics.production_promoted=false"
  echo "translate.path=$translate_module"
  echo "translate.sha256=$(sha256_file "$translate_module")"
  echo "dataset_governance.path=$dataset_governance_module"
  echo "dataset_governance.sha256=$(sha256_file "$dataset_governance_module")"
}

resolve_governance_pair() {
  local state_override="${SEMINARTEXT_STATE_FILE:-}"
  local roadmap_override="${SEMINARTEXT_ROADMAP_FILE:-}"
  local repo_override="${SEMINARTEXT_REPO:-}"
  local detected_root=""

  if [[ -n "$state_override" || -n "$roadmap_override" ]]; then
    [[ -n "$state_override" && -n "$roadmap_override" ]] || {
      echo "Ошибка: SEMINARTEXT_STATE_FILE и SEMINARTEXT_ROADMAP_FILE задаются вместе." >&2
      return 1
    }
    GOVERNANCE_STATE="${state_override/#\~/$HOME}"
    GOVERNANCE_ROADMAP="${roadmap_override/#\~/$HOME}"
    GOVERNANCE_SOURCE_KIND="explicit_pair"
  elif [[ -n "$repo_override" ]]; then
    repo_override="${repo_override/#\~/$HOME}"
    GOVERNANCE_STATE="$repo_override/SEMINARTEXT_4_STATE.json"
    GOVERNANCE_ROADMAP="$repo_override/SEMINARTEXT_4_ROADMAP.md"
    GOVERNANCE_SOURCE_KIND="repository_override"
  elif command -v git >/dev/null 2>&1; then
    detected_root="$(git -C "$SEMINARTEXT_ENTRYPOINT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$detected_root" && "$SEMINARTEXT_ENTRYPOINT" == "$detected_root/"* ]]; then
      GOVERNANCE_STATE="$detected_root/SEMINARTEXT_4_STATE.json"
      GOVERNANCE_ROADMAP="$detected_root/SEMINARTEXT_4_ROADMAP.md"
      GOVERNANCE_SOURCE_KIND="repository"
    fi
  fi

  if [[ -z "${GOVERNANCE_STATE:-}" ]]; then
    GOVERNANCE_STATE="$SEMINARTEXT_ENTRYPOINT_DIR/SEMINARTEXT_4_STATE.json"
    GOVERNANCE_ROADMAP="$SEMINARTEXT_ENTRYPOINT_DIR/SEMINARTEXT_4_ROADMAP.md"
    GOVERNANCE_SOURCE_KIND="deployed_snapshot"
  fi

  [[ -f "$GOVERNANCE_STATE" ]] || {
    echo "Ошибка: не найден governed State: $GOVERNANCE_STATE" >&2
    echo "Для installed CLI задайте SEMINARTEXT_REPO=/путь/к/repository или установите verified deploy snapshot." >&2
    return 1
  }
  [[ -f "$GOVERNANCE_ROADMAP" ]] || {
    echo "Ошибка: не найден governed Roadmap: $GOVERNANCE_ROADMAP" >&2
    return 1
  }
}

find_model() {
  local name="$1" candidate
  for candidate in \
    "$HOME/whisper-models/$name" \
    "$HOME/models/$name" \
    "$HOME/.cache/whisper/$name" \
    "$HOME/Library/Application Support/whisper.cpp/$name" \
    "/opt/homebrew/share/whisper.cpp/models/$name" \
    "/usr/local/share/whisper.cpp/models/$name"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

resolve_models() {
  [[ -n "$MODEL" ]] || MODEL="$(find_model ggml-large-v3.bin || true)"
  [[ -n "$VAD_MODEL" ]] || VAD_MODEL="$(find_model ggml-silero-v5.1.2.bin || true)"
}

