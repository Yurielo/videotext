  [[ -f "$benchmark" ]] || {
    echo "Ошибка: benchmark не найден:" >&2
    echo "  $benchmark" >&2
    return 1
  }

  "$SEMINARTEXT_PYTHON" - "$benchmark" <<'PYCHECK'
import json
import sys
from pathlib import Path

benchmark_path = Path(sys.argv[1])

data = json.loads(benchmark_path.read_text(encoding="utf-8"))
cases = data.get("cases", [])

ok = 0
errors = []

for case in cases:
    cid = case.get("case_id", "<unknown>")
    segments = case.get("segments", [])
    gold = case.get("gold", {})
    review = case.get("review", {})

    boundaries = gold.get("boundaries", [])
    topics = gold.get("topics", [])

    segment_ids = {
        int(s["id"])
        for s in segments
        if "id" in s
    }

    case_errors = []

    if review.get("status") != "gold_complete":
        case_errors.append(f'status={review.get("status")!r}')

    if not boundaries:
        case_errors.append("нет gold.boundaries")

    if not topics:
        case_errors.append("нет gold.topics")

    if len(boundaries) != len(topics):
        case_errors.append(
            f"boundaries={len(boundaries)}, topics={len(topics)}"
        )

    if boundaries != sorted(boundaries):
        case_errors.append("boundaries не отсортированы")

    if len(boundaries) != len(set(boundaries)):
        case_errors.append("есть повторяющиеся boundaries")

    bad_boundaries = [x for x in boundaries if x not in segment_ids]
    if bad_boundaries:
        case_errors.append(
            f"boundaries вне segments: {bad_boundaries}"
        )

    topic_start_ids = [t.get("start_id") for t in topics]

    if topic_start_ids != boundaries:
        case_errors.append(
            "start_id тем не совпадают с boundaries"
        )

    for i, topic in enumerate(topics, 1):
        if not str(topic.get("title", "")).strip():
            case_errors.append(f"тема {i}: пустой title")

    if case_errors:
        errors.append((cid, case_errors))
        print(f"[FAIL] {cid}")
        for e in case_errors:
            print(f"       - {e}")
    else:
        ok += 1
        print(
            f"[OK]   {cid}: "
            f"{len(boundaries)} тем, "
            f"{len(segments)} сегментов"
        )

print()
print(f"GOLD COMPLETE: {ok}/{len(cases)}")

integrity_ok = (
    not errors
    and len(cases) == 6
    and ok == 6
)

print(
    "BENCHMARK INTEGRITY: OK"
    if integrity_ok
    else "BENCHMARK INTEGRITY: FAIL"
)
print("READ-ONLY CHECK: benchmark and governance files were not modified")

if not integrity_ok:
    raise SystemExit(1)
PYCHECK
}

