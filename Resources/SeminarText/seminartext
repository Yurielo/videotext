normalize_srt_for_ffmpeg() {
  local input="$1" output="$2"
  python3 - "$input" "$output" <<'PYNORMALIZE'
import re, sys
from pathlib import Path

src = Path(sys.argv[1])
dst = Path(sys.argv[2])
raw = src.read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n").strip()
blocks = re.split(r"\n\s*\n", raw) if raw else []
out = []
number = 1
for block in blocks:
    lines = [line.rstrip() for line in block.splitlines()]
    ti = next((i for i, line in enumerate(lines) if "-->" in line), None)
    if ti is None:
        continue
    timing = lines[ti].strip()
    body = [line.strip() for line in lines[ti + 1:] if line.strip()]
    if not body:
        continue
    out.append("\n".join([str(number), timing] + body))
    number += 1
if not out:
    raise SystemExit("Не удалось нормализовать SRT для FFmpeg")
dst.write_text("\n\n".join(out) + "\n", encoding="utf-8")
PYNORMALIZE
}

subtitles_command() {
  local input="" burn=0 russian=0 output="" source_dir="" srt="" base="" stem="" target="" subtitle_tmp=""

  if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'SUBHELP'
Использование:
  seminartext subtitles файл.mp4
  seminartext subtitles файл.mp4 --burn
  seminartext subtitles файл.mp4 --output файл.srt

Логика:
  1. Ищет уже существующую расшифровку SeminarText для этого видео.
  2. Использует готовый transcriptN.srt без повторного Whisper.
  3. Копирует его рядом с видео как <имя>_subtitles.srt.
  4. При --burn дополнительно создаёт видео с вшитыми субтитрами.

Параметры:
  --burn          вшить субтитры в видео
  --russian       использовать готовый перевод transcript_ru.srt
  --output FILE   имя выходного .srt
  --force         разрешить перезапись
  -h, --help      справка
SUBHELP
    return 0
  fi

  input="$1"
  shift

  [[ -f "$input" ]] || {
    echo "Ошибка: видеофайл не найден: $input" >&2
    return 2
  }

  while (($#)); do
    case "$1" in
      --burn)
        burn=1
        ;;
      --russian)
        russian=1
        ;;
      --output)
        shift
        [[ $# -gt 0 ]] || { echo "Ошибка: после --output требуется имя файла." >&2; return 2; }
        output="$1"
        ;;
      --force)
        FORCE=1
        ;;
      -h|--help)
        subtitles_command --help
        return 0
        ;;
      *)
        echo "Ошибка: неизвестный параметр subtitles: $1" >&2
        return 2
        ;;
    esac
    shift
  done

  if [[ -f "$input.seminartext.json" ]]; then
    local derived_status=0
    python3 - "$TRANSCRIPTS_ROOT" "$input" "$input.seminartext.json" "$output" "$FORCE" "$russian" <<'PYCLIP' || derived_status=$?
import json, re, sys
from pathlib import Path

root = Path(sys.argv[1])
clip = Path(sys.argv[2])
meta_path = Path(sys.argv[3])
requested_output = sys.argv[4]
force = int(sys.argv[5])
russian = int(sys.argv[6])

meta = json.loads(meta_path.read_text(encoding="utf-8"))
source = str(Path(meta["source"]).resolve())
start = float(meta["start_seconds"])
end = float(meta["end_seconds"])

source_dir = None
if root.is_dir():
    for p in root.rglob(".source_path"):
        try:
            value = p.read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            continue
        try:
            resolved = str(Path(value).expanduser().resolve())
        except Exception:
            resolved = value
        if resolved == source:
            source_dir = p.parent
            break

if source_dir is None:
    source_name = Path(source).name
    for p in root.rglob(".source_path"):
        try:
            value = p.read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            continue
        if Path(value).name == source_name:
            source_dir = p.parent
            break

if source_dir is None:
    raise SystemExit(10)

candidates = []
plain = source_dir / ("transcript_ru.srt" if russian else "transcript.srt")
if plain.is_file():
    candidates.append((0, plain))
for p in source_dir.glob("transcript*.srt"):
    if russian and p.name == "transcript_ru.srt":
        candidates.append((10**9, p))
        continue
    m = re.fullmatch(r"transcript(\d+)\.srt", p.name)
    if m:
        candidates.append((int(m.group(1)), p))
if not candidates:
    raise SystemExit(11)
candidates.sort(key=lambda x: x[0])
src = candidates[-1][1]

dst = Path(requested_output).expanduser() if requested_output else clip.with_name(clip.stem + "_subtitles.srt")
if dst.exists() and not force:
    print(f"Готовый SRT уже существует, используется повторно: {dst}")
    raise SystemExit(0)

def parse_time(s):
    h, m, rest = s.split(":")
    sec, ms = rest.split(",")
    return ((int(h)*60+int(m))*60+int(sec))*1000+int(ms)

def fmt(ms):
    ms = max(0, int(round(ms)))
    xms = ms % 1000
    total = ms // 1000
    sec = total % 60
    total //= 60
    minute = total % 60
    hour = total // 60
    return f"{hour:02d}:{minute:02d}:{sec:02d},{xms:03d}"

start_ms = int(round(start * 1000))
end_ms = int(round(end * 1000))
raw = src.read_text(encoding="utf-8", errors="replace").strip()
blocks = re.split(r"\n\s*\n", raw) if raw else []
out = []
idx = 1

for block in blocks:
    lines = block.splitlines()
    ti = next((i for i, line in enumerate(lines) if "-->" in line), None)
    if ti is None:
        continue
    a, b = [x.strip() for x in lines[ti].split("-->", 1)]
    a_ms, b_ms = parse_time(a), parse_time(b)
    if b_ms <= start_ms or a_ms >= end_ms:
        continue
    new_a = max(a_ms, start_ms) - start_ms
    new_b = min(b_ms, end_ms) - start_ms
    body = lines[ti+1:]
    if not body:
        continue
    out.append("\n".join([str(idx), f"{fmt(new_a)} --> {fmt(new_b)}"] + body))
    idx += 1

if not out:
    raise SystemExit(13)

dst.parent.mkdir(parents=True, exist_ok=True)
dst.write_text("\n\n".join(out) + "\n", encoding="utf-8")
print(f"SRT ГОТОВ ИЗ РАСШИФРОВКИ ИСХОДНИКА: {dst}")
raise SystemExit(0)
PYCLIP

    if (( derived_status == 0 )); then
      if (( burn == 0 )); then
        return 0
      fi

      base="$(basename "$input")"
      stem="${base%.*}"

      if [[ -z "$output" ]]; then
        output="$(dirname "$input")/${stem}_subtitles.srt"
      fi

      local burn_ffmpeg=""
      if [[ -x "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg" ]]; then
