import sys
from pathlib import Path

project = Path(sys.argv[1]).resolve()
registry = Path(sys.argv[2])
queue = Path(sys.argv[3])
only_source = sys.argv[4].strip()

data = json.loads(registry.read_text(encoding="utf-8"))
videos = sorted(data.get("videos", []), key=lambda x: x.get("order", 999999))

with queue.open("w", encoding="utf-8") as out:
    for item in videos:
        sid = item.get("source_id")
        if not sid:
            continue
        if only_source and sid != only_source:
            continue

        typ = item.get("type")
        title = item.get("title") or sid
        order = item.get("order", 0)

        if typ == "local":
            rel = item.get("file", "")
            source = project / rel
            if not source.is_file():
                print(f"[ОШИБКА] Не найден файл {sid}: {source}", file=sys.stderr)
                continue
            value = str(source)

        elif typ == "youtube":
            value = item.get("url", "")
            if not value:
                continue

        else:
            print(f"[SKIP] Неизвестный тип {sid}: {typ}", file=sys.stderr)
            continue

        record = {
            "source_id": sid,
            "order": order,
            "type": typ,
            "title": title,
            "source": value,
        }

        out.write(json.dumps(record, ensure_ascii=False) + "\n")
PYQUEUE

  if (( dry_run == 1 )); then
    echo "Очередь project-transcribe:"
    if [[ -s "$queue" ]]; then
      python3 - "$queue" <<'PYDRY'
import json
import sys
