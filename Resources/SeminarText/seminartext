cut_command() {
  local input="" start="" end="" output="" mode="exact"
  local duration start_sec end_sec out_dir base stem ext

  if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'CUTHELP'
Использование:
  seminartext cut файл.mp4 START END
  seminartext cut файл.mp4 START END --fast
  seminartext cut файл.mp4 START END --output результат.mp4

Примеры:
  seminartext cut video.mp4 00:15:29 00:17:36
  seminartext cut video.mp4 15:29 17:36
  seminartext cut video.mp4 75 105
  seminartext cut video.mp4 00:15:29 00:17:36 --fast

Форматы времени:
  HH:MM:SS
  MM:SS
  секунды

Режимы:
  по умолчанию  точная резка с перекодированием H.264 + AAC
  --fast        быстрая резка без перекодирования; граница может сместиться
                к ближайшему ключевому кадру

Параметры:
  --output FILE   явно задать имя выходного файла
  --force         разрешить перезапись существующего выходного файла
  -h, --help      справка
CUTHELP
    return 0
  fi

  input="$1"
  shift

  [[ -f "$input" ]] || {
    echo "Ошибка: видеофайл не найден: $input" >&2
    return 2
  }

  if [[ $# -lt 2 ]]; then
    echo "Ошибка: укажите начало и конец фрагмента." >&2
    echo "Пример: seminartext cut video.mp4 00:15:29 00:17:36" >&2
    return 2
  fi

  start="$1"
  end="$2"
  shift 2

  while (($#)); do
    case "$1" in
      --fast)
        mode="fast"
        ;;
      --output)
        shift
        [[ $# -gt 0 ]] || {
          echo "Ошибка: после --output требуется имя файла." >&2
          return 2
        }
        output="$1"
        ;;
      --force)
        FORCE=1
        ;;
      -h|--help)
        cut_command --help
        return 0
        ;;
      *)
        echo "Ошибка: неизвестный параметр cut: $1" >&2
        return 2
        ;;
    esac
    shift
  done

  command -v ffmpeg >/dev/null 2>&1 || { echo "Ошибка: ffmpeg не найден." >&2; return 1; }
  command -v ffprobe >/dev/null 2>&1 || { echo "Ошибка: ffprobe не найден." >&2; return 1; }

  read -r start_sec end_sec < <(
    python3 - "$start" "$end" <<'PYTIME'
import sys

def parse(value: str) -> float:
    value = value.strip()
    if not value:
        raise ValueError("пустое значение")
    if ":" not in value:
        x = float(value.replace(",", "."))
        if x < 0:
            raise ValueError("отрицательное время")
        return x
    parts = value.split(":")
    if len(parts) not in (2, 3):
        raise ValueError("ожидался формат MM:SS или HH:MM:SS")
    nums = [float(x.replace(",", ".")) for x in parts]
    if any(x < 0 for x in nums):
        raise ValueError("отрицательное время")
    if len(nums) == 2:
        m, s = nums
        if s >= 60:
            raise ValueError("секунды должны быть меньше 60")
        return m * 60 + s
    h, m, s = nums
    if m >= 60 or s >= 60:
        raise ValueError("минуты и секунды должны быть меньше 60")
    return h * 3600 + m * 60 + s

try:
    a = parse(sys.argv[1])
    b = parse(sys.argv[2])
except Exception as exc:
    print(f"ОШИБКА ВРЕМЕНИ: {exc}", file=sys.stderr)
    raise SystemExit(2)
print(f"{a:.3f} {b:.3f}")
PYTIME
  ) || return 2

  python3 - "$start_sec" "$end_sec" <<'PYORDER'
import sys
a = float(sys.argv[1])
b = float(sys.argv[2])
if b <= a:
    print("Ошибка: конец фрагмента должен быть позже начала.", file=sys.stderr)
    raise SystemExit(2)
PYORDER

  duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$input")" || {
    echo "Ошибка: ffprobe не смог определить длительность файла." >&2
    return 1
  }

  python3 - "$start_sec" "$end_sec" "$duration" <<'PYDUR'
import sys
a = float(sys.argv[1])
b = float(sys.argv[2])
d = float(sys.argv[3])
if a >= d:
    print(f"Ошибка: начало фрагмента ({a:.3f} с) находится за пределами видео ({d:.3f} с).", file=sys.stderr)
    raise SystemExit(2)
if b > d + 0.05:
    print(f"Ошибка: конец фрагмента ({b:.3f} с) превышает длительность видео ({d:.3f} с).", file=sys.stderr)
    raise SystemExit(2)
PYDUR

  if [[ -z "$output" ]]; then
    out_dir="$(dirname "$input")"
    base="$(basename "$input")"
    if [[ "$base" == *.* ]]; then
      stem="${base%.*}"
      ext=".${base##*.}"
    else
      stem="$base"
      ext=".mp4"
    fi
    output="$out_dir/${stem}_cut_${start//:/-}_${end//:/-}${ext}"
  fi

  if [[ -e "$output" && "$FORCE" -eq 0 ]]; then
    if [[ -s "$output" && -s "$output.seminartext.json" ]]; then
      echo "Готовый фрагмент уже существует, используется повторно: $output"
      return 0
    fi
    echo "Ошибка: выходной файл уже существует, но у него нет корректных метаданных:" >&2
    echo "  $output" >&2
    echo "Используйте --force для пересоздания фрагмента." >&2
    return 2
  fi

  mkdir -p "$(dirname "$output")"

  echo "Режу видео..."
  echo "Источник: $input"
  echo "Начало:   $start"
  echo "Конец:    $end"
  echo "Режим:    $mode"
  echo "Результат: $output"

  if [[ "$mode" == "fast" ]]; then
    ffmpeg -hide_banner -y -ss "$start_sec" -to "$end_sec" -i "$input" -map 0 -c copy "$output"
  else
    ffmpeg -hide_banner -y -ss "$start_sec" -to "$end_sec" -i "$input" \
      -map 0:v:0 -map 0:a? \
      -c:v libx264 -preset medium -crf 18 \
      -c:a aac -b:a 192k -movflags +faststart "$output"
  fi

  [[ -s "$output" ]] || {
    echo "Ошибка: выходной файл не создан или пуст." >&2
    return 1
  }

  python3 - "$output.seminartext.json" "$input" "$start_sec" "$end_sec" "$mode" <<'PYMETA'
import json, sys
from pathlib import Path
meta = {
    "type": "seminartext_clip",
    "source": str(Path(sys.argv[2]).resolve()),
    "start_seconds": float(sys.argv[3]),
    "end_seconds": float(sys.argv[4]),
    "mode": sys.argv[5],
}
Path(sys.argv[1]).write_text(
    json.dumps(meta, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
PYMETA

  echo "Метаданные: $output.seminartext.json"
  echo "ГОТОВО: $output"
}


