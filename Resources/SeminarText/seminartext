  project_dir="${project_dir/#\~/$HOME}"

  if [[ ! -d "$project_dir" ]]; then
    echo "Ошибка: папка проекта не найдена:" >&2
    echo "$project_dir" >&2
    return 1
  fi

  local registry="$project_dir/sources.json"

  if [[ ! -f "$registry" ]]; then
