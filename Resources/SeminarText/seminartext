import json
import sys
from pathlib import Path

benchmark_path = Path(sys.argv[1])
case_id = sys.argv[2]
boundaries_raw = sys.argv[3]
topics_file = sys.argv[4].strip()
notes = sys.argv[5]

data = json.loads(
    benchmark_path.read_text(encoding="utf-8")
)

case = next(
    (x for x in data.get("cases", []) if x.get("case_id") == case_id),
    None,
)

if case is None:
    raise SystemExit(
        f"Ошибка: benchmark case не найден: {case_id}"
    )

valid_ids = {
    int(x["id"])
    for x in case.get("segments", [])
}

try:
    boundaries = [
        int(x.strip())
        for x in boundaries_raw.split(",")
        if x.strip()
    ]
except ValueError:
    raise SystemExit(
        "Ошибка: boundaries должны быть целыми ID через запятую"
    )

boundaries = sorted(set(boundaries))

if not boundaries:
    raise SystemExit("Ошибка: boundaries пусты")

first_id = int(case["first_segment_id"])

if boundaries[0] != first_id:
    raise SystemExit(
        f"Ошибка: первая граница должна быть {first_id}, "
        f"получено {boundaries[0]}"
    )

invalid = [
    x for x in boundaries
    if x not in valid_ids
]

if invalid:
    raise SystemExit(
        f"Ошибка: ID отсутствуют в benchmark case: {invalid}"
    )

topics = []

if topics_file:
    p = Path(topics_file)
    topics = json.loads(
        p.read_text(encoding="utf-8")
    )

    if not isinstance(topics, list):
        raise SystemExit(
            "Ошибка: topics-file должен содержать JSON-массив"
        )

    topic_ids = []

    for topic in topics:
        if not isinstance(topic, dict):
            raise SystemExit(
                "Ошибка: каждый topic должен быть объектом"
            )

        sid = int(topic.get("start_id"))
        topic_ids.append(sid)

        if sid not in boundaries:
            raise SystemExit(
                f"Ошибка: topic start_id {sid} "
                "не входит в gold boundaries"
            )

    if sorted(set(topic_ids)) != boundaries:
        raise SystemExit(
            "Ошибка: topics-file должен содержать ровно "
            "по одной теме на каждую boundary"
        )

case["gold"]["boundaries"] = boundaries
case["gold"]["topics"] = topics

case["review"]["status"] = (
    "gold_complete"
    if topics
    else "boundaries_complete"
)

case["review"]["notes"] = notes

benchmark_path.write_text(
    json.dumps(
        data,
        ensure_ascii=False,
        indent=2,
    ) + "\n",
    encoding="utf-8",
)

print("[OK] Benchmark case обновлён")
print("Case:", case_id)
print("Boundaries:", boundaries)
print("Topics:", len(topics))
print("Status:", case["review"]["status"])
PYLABEL
}

