    echo "$project_dir" >&2
    return 1
  fi

  if [[ ! -f "$project_dir/sources.json" ]]; then
    echo "Ошибка: sources.json не найден." >&2
    return 1
  fi

  mkdir -p "$project_dir/analysis"

  "$SEMINARTEXT_PYTHON" - "$project_dir" <<'PYCORPUS'
import json
import sys
from pathlib import Path

project = Path(sys.argv[1]).expanduser().resolve()

sources = json.loads(
    (project / "sources.json").read_text(encoding="utf-8")
)

items = []

stats = {
    "video_segments": 0,
    "slides": 0,
    "pdf_pages": 0,
    "total_items": 0
}

# ------------------------------------------
# VIDEO
# ------------------------------------------

videos = sorted(
    sources.get("videos", []),
    key=lambda x: x.get("order", 999999)
)

for video in videos:
    sid = video.get("source_id")

    if not sid:
        continue

    transcript_path = project / "transcript" / f"{sid}.json"

    if not transcript_path.is_file():
        print(f"[ПРЕДУПРЕЖДЕНИЕ] Нет transcript JSON: {sid}")
        continue

    data = json.loads(
        transcript_path.read_text(encoding="utf-8")
    )

    for segment in data.get("segments", []):
        seg_id = int(segment.get("id", 0))

        start_tc = segment.get("start_tc", "")
        end_tc = segment.get("end_tc", "")

        items.append({
            "evidence_id": f"{sid}:segment:{seg_id:06d}",
            "source_id": sid,
            "source_type": "video",
            "order": video.get("order"),
            "title": video.get("title", ""),
            "locator": {
                "segment": seg_id,
                "start": segment.get("start"),
                "end": segment.get("end"),
                "start_tc": start_tc,
                "end_tc": end_tc
            },
            "human_locator": f"{sid} {start_tc}–{end_tc}",
            "text": segment.get("text", "").strip()
        })

        stats["video_segments"] += 1


# ------------------------------------------
# DOCUMENTS
# ------------------------------------------

for document in sources.get("documents", []):
    sid = document.get("source_id")
    typ = document.get("type")
    title = document.get("title", "")

    if not sid:
        continue

    # PPTX
    if typ == "presentation":
        p = project / "presentation" / sid / "slides.json"

        if not p.is_file():
            print(f"[ПРЕДУПРЕЖДЕНИЕ] Нет slides.json: {sid}")
            continue

        data = json.loads(
            p.read_text(encoding="utf-8")
        )

        for slide in data.get("slides", []):
            number = int(slide.get("slide", 0))

            parts = []

            if slide.get("text"):
                parts.append(slide["text"])

            if slide.get("notes"):
                parts.append(slide["notes"])

            content = "\n".join(parts).strip()

            if not content:
                continue

            items.append({
                "evidence_id": f"{sid}:slide:{number:04d}",
                "source_id": sid,
                "source_type": "presentation",
                "title": title,
                "locator": {
                    "slide": number
                },
                "human_locator": f"{sid} slide {number}",
                "text": content
            })

            stats["slides"] += 1

    # PDF / handout
    else:
        p = project / "analysis" / "documents" / f"{sid}.json"

        if not p.is_file():
            print(f"[ПРЕДУПРЕЖДЕНИЕ] Нет document JSON: {sid}")
            continue

        data = json.loads(
            p.read_text(encoding="utf-8")
        )

        for page in data.get("pages", []):
            number = int(page.get("page", 0))
            content = page.get("text", "").strip()

            if not content:
                continue

            items.append({
                "evidence_id": f"{sid}:page:{number:04d}",
                "source_id": sid,
                "source_type": typ or "document",
                "title": title,
                "locator": {
                    "page": number
                },
                "human_locator": f"{sid} page {number}",
                "text": content
            })

            stats["pdf_pages"] += 1


stats["total_items"] = len(items)

corpus = {
    "schema_version": 1,
    "project": project.name,
    "stats": stats,
    "items": items
}

analysis = project / "analysis"

corpus_path = analysis / "corpus.json"
jsonl_path = analysis / "corpus.jsonl"
stats_path = analysis / "corpus_stats.json"

corpus_path.write_text(
    json.dumps(corpus, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8"
)

with jsonl_path.open("w", encoding="utf-8") as f:
    for item in items:
        f.write(json.dumps(item, ensure_ascii=False) + "\n")

stats_path.write_text(
    json.dumps(stats, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8"
)

print("CORPUS ГОТОВ")
print()
print(f"Видео-сегментов: {stats['video_segments']}")
print(f"Слайдов с текстом: {stats['slides']}")
print(f"PDF-страниц с текстом: {stats['pdf_pages']}")
print(f"Всего evidence units: {stats['total_items']}")
print()
print(f"corpus.json: {corpus_path}")
print(f"corpus.jsonl: {jsonl_path}")
print(f"corpus_stats.json: {stats_path}")
PYCORPUS
}

project_documents() {
  local project_arg="${1:-}"

  if [[ -z "$project_arg" ]]; then
    echo 'Ошибка: укажите проект.' >&2
    echo 'Пример: seminartext project-documents "Стресс код"' >&2
    return 2
  fi

  local projects_root="${SEMINARTEXT_PROJECTS:-$HOME/Documents/seminartext_projects}"
  local project_dir

  project_arg="${project_arg/#\~/$HOME}"

  if [[ -d "$project_arg" ]]; then
    project_dir="$project_arg"
  else
    project_dir="$projects_root/$(sanitize_name "$project_arg")"
  fi

  if [[ ! -d "$project_dir" ]]; then
    echo "Ошибка: проект не найден:" >&2
    echo "$project_dir" >&2
    return 1
  fi

  local registry="$project_dir/sources.json"

  if [[ ! -f "$registry" ]]; then
    echo "Ошибка: sources.json не найден:" >&2
    echo "$registry" >&2
    return 1
  fi

  if [[ ! -x "$SEMINARTEXT_PYTHON" ]]; then
    echo "Ошибка: Python-окружение SeminarText не найдено:" >&2
    echo "$SEMINARTEXT_PYTHON" >&2
    return 1
  fi

  if ! "$SEMINARTEXT_PYTHON" -c 'import pptx, pymupdf' >/dev/null 2>&1; then
    echo "Ошибка: нужны python-pptx и PyMuPDF." >&2
    echo "Выполните: seminartext doctor" >&2
    return 1
  fi

  mkdir -p "$project_dir/presentation"
  mkdir -p "$project_dir/analysis/documents"

  "$SEMINARTEXT_PYTHON" - "$project_dir" "$registry" <<'PYDOC'
import json
import sys
from pathlib import Path

import pymupdf
from pptx import Presentation

project = Path(sys.argv[1]).expanduser().resolve()
registry = Path(sys.argv[2])

data = json.loads(registry.read_text(encoding="utf-8"))
documents = data.get("documents", [])

combined = {
    "schema_version": 1,
    "project": project.name,
    "documents": []
}

def clean_text(value: str) -> str:
    lines = []
    for line in value.replace("\r", "\n").split("\n"):
        line = " ".join(line.split())
        if line:
            lines.append(line)
    return "\n".join(lines)

def extract_pptx(item, source):
    sid = item["source_id"]
    out_dir = project / "presentation" / sid
    out_dir.mkdir(parents=True, exist_ok=True)

    prs = Presentation(str(source))
    slides = []
    text_parts = []

    for number, slide in enumerate(prs.slides, start=1):
        parts = []
        image_count = 0

        for shape in slide.shapes:
            if getattr(shape, "shape_type", None) == 13:
                image_count += 1

            if hasattr(shape, "text"):
                value = clean_text(shape.text)
                if value:
                    parts.append(value)

            if getattr(shape, "has_table", False):
                for row in shape.table.rows:
                    cells = []
                    for cell in row.cells:
                        value = clean_text(cell.text)
                        if value:
                            cells.append(value)
                    if cells:
                        parts.append(" | ".join(cells))

        notes = ""
        try:
            notes_slide = slide.notes_slide
            chunks = []
            for shape in notes_slide.shapes:
                if hasattr(shape, "text"):
                    value = clean_text(shape.text)
                    if value and value not in chunks:
                        chunks.append(value)
            notes = "\n".join(chunks)
        except Exception:
            pass

        slide_text = "\n".join(dict.fromkeys(parts))

        record = {
            "slide": number,
            "text": slide_text,
            "notes": notes,
            "image_count": image_count,
            "has_text": bool(slide_text or notes),
        }

        slides.append(record)

        text_parts.append(f"=== СЛАЙД {number} ===")
        if slide_text:
            text_parts.append(slide_text)
        if notes:
            text_parts.append("[ЗАМЕТКИ]")
            text_parts.append(notes)
        if not slide_text and not notes:
            text_parts.append("[ТЕКСТ НЕ ОБНАРУЖЕН]")
        text_parts.append("")

    result = {
        "schema_version": 1,
        "source_id": sid,
        "type": "presentation",
        "title": item.get("title", ""),
        "source_file": item.get("file", ""),
        "slide_count": len(slides),
        "slides": slides
    }

    (out_dir / "slides.json").write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8"
    )

    (out_dir / "text.txt").write_text(
        "\n".join(text_parts),
        encoding="utf-8"
    )

    print(f"[OK] {sid} PPTX — {len(slides)} слайдов")

    return {
        "source_id": sid,
        "type": "presentation",
        "title": item.get("title", ""),
        "source_file": item.get("file", ""),
        "unit": "slide",
        "unit_count": len(slides),
        "content": slides
    }

def extract_pdf(item, source):
    sid = item["source_id"]
    pdf = pymupdf.open(str(source))

    pages = []
    text_parts = []

    for index, page in enumerate(pdf, start=1):
        text = clean_text(page.get_text("text") or "")
        images = page.get_images(full=True)

        # Низкий объём текста + изображения = кандидат на OCR/визуальный анализ.
        needs_ocr = len(text) < 40 and len(images) > 0

        record = {
            "page": index,
            "text": text,
            "image_count": len(images),
            "has_text": bool(text),
            "needs_ocr": needs_ocr
        }

        pages.append(record)

        text_parts.append(f"=== СТРАНИЦА {index} ===")
        if text:
            text_parts.append(text)
        else:
            text_parts.append("[ТЕКСТ НЕ ОБНАРУЖЕН]")
        if needs_ocr:
            text_parts.append("[ВОЗМОЖНО НУЖЕН OCR]")
        text_parts.append("")

    pdf.close()

    result = {
        "schema_version": 1,
        "source_id": sid,
        "type": item.get("type", "handout"),
        "title": item.get("title", ""),
        "source_file": item.get("file", ""),
        "page_count": len(pages),
        "pages": pages
    }

    out_json = project / "analysis" / "documents" / f"{sid}.json"
    out_txt = project / "analysis" / "documents" / f"{sid}.txt"

    out_json.write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8"
    )

    out_txt.write_text(
        "\n".join(text_parts),
        encoding="utf-8"
    )

    ocr_count = sum(1 for p in pages if p["needs_ocr"])
    print(
        f"[OK] {sid} PDF — {len(pages)} стр."
        + (f" | OCR-кандидатов: {ocr_count}" if ocr_count else "")
    )

    return {
        "source_id": sid,
        "type": item.get("type", "handout"),
        "title": item.get("title", ""),
        "source_file": item.get("file", ""),
        "unit": "page",
        "unit_count": len(pages),
        "content": pages
    }

processed = 0

for item in documents:
    sid = item.get("source_id")
    rel = item.get("file", "")
    typ = item.get("type", "")

    if not sid or not rel:
        continue

    source = project / rel

    if not source.is_file():
        print(f"[ОШИБКА] {sid}: файл не найден: {source}")
        continue

    suffix = source.suffix.lower()

    try:
        if typ == "presentation" and suffix == ".pptx":
            combined["documents"].append(extract_pptx(item, source))
            processed += 1

        elif suffix == ".pdf":
            combined["documents"].append(extract_pdf(item, source))
            processed += 1

        else:
            print(f"[ПРОПУСК] {sid}: пока не поддерживается {suffix or typ}")

    except Exception as exc:
        print(f"[ОШИБКА] {sid}: {exc}")

combined_path = project / "analysis" / "documents" / "combined_documents.json"
combined_path.write_text(
    json.dumps(combined, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8"
)

print()
print(f"Обработано документов: {processed}")
print(f"combined_documents.json: {combined_path}")
PYDOC

  echo
  echo "ГОТОВО: документы проекта обработаны"
}

project_transcribe() {
  local project_dir="${1:-}"
  local only_source=""
  local dry_run=0
  local combined_clear=0
  local combined_with_sources=0

  if [[ "$project_dir" == "-h" || "$project_dir" == "--help" ]]; then
    cat <<'HELP'
Использование:

  seminartext project-transcribe PROJECT [--careful] [--structured-timing] [--combined-clear] [--combined-with-sources]
  seminartext project-transcribe PROJECT --only video_001 [--careful] [--structured-timing]

--combined-clear создаёт чистый chronological derived artifact из сохранённых
individual transcript_clean.txt локальных частей: embedded creation date,
macOS birth time, затем mtime. --combined-with-sources дополнительно создаёт
вариант с filename и датами; provenance находится в combined_clear_manifest.json.

--careful использует существующие тщательные параметры распознавания для
каждого фрагмента проекта. Защитная повторная попытка остаётся одинаковой
для обоих режимов.

--structured-timing сохраняет JSON-full только выбранных Whisper-попыток и
manifest с абсолютными временными смещениями частей.
HELP
    return 0
  fi

  if [[ -z "$project_dir" ]]; then
    echo 'Ошибка: укажите папку проекта.' >&2
    echo 'Пример: seminartext project-transcribe "/путь/к/проекту"' >&2
    return 2
  fi

  shift || true

  while (($#)); do
    case "$1" in
      --only)
        [[ $# -ge 2 ]] || {
          echo "Ошибка: после --only нужен source_id" >&2
          return 2
        }
        only_source="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --careful)
        MODE="careful"
        shift
        ;;
      --structured-timing)
        STRUCTURED_TIMING=1
        shift
        ;;
      --no-open)
        OPEN_RESULTS=0
        shift
        ;;
      --combined-clear)
        combined_clear=1
        shift
        ;;
      --combined-with-sources)
        combined_clear=1
        combined_with_sources=1
        shift
        ;;
      -h|--help)
        cat <<'HELP'
Использование:

  seminartext project-transcribe PROJECT [--careful] [--structured-timing] [--combined-clear] [--combined-with-sources]
  seminartext project-transcribe PROJECT --only video_001 [--careful] [--structured-timing]
  seminartext project-transcribe PROJECT --only video_001 --dry-run

--only SOURCE_ID
    Обработать только указанный видеоисточник.

--dry-run
    Только показать очередь обработки. Whisper не запускается.

--careful
    Использовать существующие тщательные параметры распознавания: более
    широкий beam search и VAD, рассчитанный на менее агрессивное отсечение
    речи. Защитная повторная попытка при ошибке или подозрительном фрагменте
    одинакова для обоих режимов.

--structured-timing
    Сохранить JSON-full выбранных Whisper-попыток и manifest с абсолютными
    временными смещениями частей без дополнительного запуска Whisper.

--no-open
    Не открывать GUI/папку результатов. В CI, pytest и Codex headless mode
    это поведение включается автоматически; также можно задать
    SEMINARTEXT_HEADLESS=1.

--combined-clear
    После успешной обработки дополнительно создать
    transcript/combined_clear.txt из сохранённых transcript_clean.txt
    локальных источников. Части сортируются по дате создания: embedded
    media date, затем macOS birth time, затем mtime. Равные даты
    разрешаются детерминированно по filename и source_id. Это derived
    artifact: individual transcripts не заменяются; lineage сохраняется в
    transcript/combined_clear_manifest.json.

--combined-with-sources
    Также создать transcript/combined_clear_with_sources.txt с читаемыми
    границами filename и разрешённой датой. Включает --combined-clear.

Если даты неверны или потеряны, проверьте metadata исходных файлов: mtime
используется только как fallback. Для пользовательского ручного порядка
предусмотрены будущие ordering_method filename, selection_order и manual;
сейчас реализован creation_date.
HELP
        return 0
        ;;
      *)
        echo "Ошибка: неизвестный параметр project-transcribe: $1" >&2
        return 2
        ;;
    esac
  done

  project_dir="${project_dir/#\~/$HOME}"

  if [[ ! -d "$project_dir" ]]; then
    echo "Ошибка: проект не найден: $project_dir" >&2
    return 1
  fi

  local registry="$project_dir/sources.json"

  if [[ ! -f "$registry" ]]; then
    echo "Ошибка: sources.json не найден." >&2
    return 1
  fi

  resolve_models

  for p in python3 ffmpeg ffprobe whisper-cli; do
    command -v "$p" >/dev/null 2>&1 || {
      echo "Не установлена программа: $p" >&2
      return 1
    }
  done

  [[ -n "$MODEL" && -f "$MODEL" ]] || {
    echo "Не найдена Whisper model." >&2
    return 1
  }

  [[ -n "$VAD_MODEL" && -f "$VAD_MODEL" ]] || {
    echo "Не найдена VAD model." >&2
    return 1
  }

  mkdir -p "$project_dir/transcript"

  local queue
  queue="$(mktemp -t seminartext_project.XXXXXX)"

  python3 - "$project_dir" "$registry" "$queue" "$only_source" <<'PYQUEUE'
