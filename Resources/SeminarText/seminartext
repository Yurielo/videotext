      echo "ОШИБКА: $path" >&2
    fi
  done < "$q"

  rm -f "$q"
  echo
  echo "Завершено. Успешно: $((count - failed)); ошибок: $failed"
  if (( OPEN_RESULTS == 1 )); then
    open "$TRANSCRIPTS_ROOT" 2>/dev/null || true
  fi
  ((failed == 0))
