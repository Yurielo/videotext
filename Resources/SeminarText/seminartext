import json
import shutil
import sys
from pathlib import Path
from urllib.parse import urlparse

project = Path(sys.argv[1]).expanduser().resolve()
items = sys.argv[2:]

registry_path = project / "sources.json"

if registry_path.exists():
    try:
        data = json.loads(registry_path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(f"Ошибка чтения sources.json: {exc}")
else:
    data = {
        "schema_version": 1,
        "videos": [],
        "documents": []
    }

data.setdefault("schema_version", 1)
data.setdefault("videos", [])
data.setdefault("documents", [])

def next_id(prefix, existing):
    nums = []
    for item in existing:
        sid = str(item.get("source_id", ""))
        if sid.startswith(prefix + "_"):
            try:
                nums.append(int(sid.split("_")[-1]))
            except ValueError:
                pass
    return f"{prefix}_{max(nums, default=0)+1:03d}"

def is_youtube(url):
    try:
        host = (urlparse(url).hostname or "").lower()
    except Exception:
        return False
    return (
        host == "youtu.be"
        or host == "youtube.com"
        or host.endswith(".youtube.com")
    )

def unique_destination(folder: Path, source: Path) -> Path:
    dest = folder / source.name
    if not dest.exists():
        return dest

    stem = source.stem
    suffix = source.suffix
    n = 2
    while True:
        candidate = folder / f"{stem}_{n}{suffix}"
        if not candidate.exists():
            return candidate
        n += 1

def already_registered_url(url):
    return any(
        item.get("type") == "youtube" and item.get("url") == url
        for item in data["videos"]
    )

def already_registered_file(relative_path):
    for group in ("videos", "documents"):
        for item in data[group]:
            if item.get("file") == relative_path:
                return True
    return False

added = []

def save_registry():
    registry_path.write_text(
        json.dumps(data, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

for raw in items:
    if "::" not in raw:
        print(f"[SKIP] Некорректная запись: {raw}")
        continue

    kind, value = raw.split("::", 1)
    value = value.strip()

    if kind == "youtube":
        if not is_youtube(value):
            print(f"[ОШИБКА] Не похоже на YouTube URL: {value}")
            continue

        if already_registered_url(value):
            print(f"[SKIP] YouTube уже зарегистрирован: {value}")
            continue

        sid = next_id("video", data["videos"])
        order = len(data["videos"]) + 1

        record = {
            "source_id": sid,
            "order": order,
            "type": "youtube",
            "url": value,
            "title": ""
        }

        data["videos"].append(record)
        added.append(record)
        save_registry()
        print(f"[OK] {sid} YouTube #{order}")
        print(f"     {value}")
        continue

    src = Path(value).expanduser()

    if not src.is_file():
        print(f"[ОШИБКА] Файл не найден: {src}")
        continue

    src = src.resolve()

    if kind in ("video", "video_link"):
        target_dir = project / "source" / "video"
        prefix = "video"
        collection = data["videos"]
        record_type = "local"
    elif kind == "presentation":
        target_dir = project / "source" / "presentations"
        prefix = "doc"
        collection = data["documents"]
        record_type = "presentation"
    elif kind == "handout":
        target_dir = project / "source" / "handouts"
        prefix = "doc"
        collection = data["documents"]
        record_type = "handout"
    elif kind == "document":
        target_dir = project / "source" / "other"
        prefix = "doc"
        collection = data["documents"]
        record_type = "other"
    else:
        print(f"[SKIP] Неизвестный тип: {kind}")
        continue

    target_dir.mkdir(parents=True, exist_ok=True)

    if kind == "video_link":
        dst = unique_destination(target_dir, src)

        print(f"[LINK] {src}")
        print(f"    -> {dst}")

        try:
            dst.symlink_to(src)
        except OSError as exc:
            print(f"[ОШИБКА LINK] {exc}")
            continue

        rel = str(dst.relative_to(project))

    else:
        # Если файл с тем же именем уже полностью скопирован,
        # переиспользуем его вместо создания дубликата.
        same_name = target_dir / src.name

        try:
            src_size = src.stat().st_size
        except OSError as exc:
            print(f"[ОШИБКА] Не удалось определить размер: {src}: {exc}")
            continue

        reuse_existing = False

        if same_name.is_file():
            try:
                dst_size = same_name.stat().st_size
            except OSError:
                dst_size = -1

            if src_size > 0 and dst_size == src_size:
                dst = same_name
                reuse_existing = True
                print(f"[REUSE] Уже скопирован полный файл:")
                print(f"        {dst}")

        if not reuse_existing:
            dst = unique_destination(target_dir, src)
            partial = dst.with_name(dst.name + ".partial")

            # Старый partial от аварийного завершения не используем.
            try:
                partial.unlink(missing_ok=True)
            except OSError:
                pass

            print(f"[COPY] {src}")
            print(f"    -> {dst}")
            print(f"    size: {src_size} bytes")

            try:
                shutil.copy2(src, partial)

                copied_size = partial.stat().st_size

                if copied_size != src_size:
                    raise IOError(
                        f"неполная копия: {copied_size} из {src_size} bytes"
                    )

                partial.replace(dst)

            except BaseException:
                try:
                    partial.unlink(missing_ok=True)
                except OSError:
                    pass
                raise

        rel = str(dst.relative_to(project))

    if already_registered_file(rel):
        print(f"[SKIP] Уже зарегистрирован: {rel}")
