choose_output_dir() {
  local requested="$1" input="$2" name base dir n existing_source

  if [[ -n "${PROJECT_OUTPUT_DIR:-}" ]]; then
    printf '%s\n' "$PROJECT_OUTPUT_DIR"
    return 0
  fi
  name="$(sanitize_name "$requested")"
