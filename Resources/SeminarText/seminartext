raise SystemExit(1)
PYFIND
  )" || {
    echo "Ошибка: для этого видео не найдена готовая расшифровка SeminarText." >&2
    echo "Сначала выполните: seminartext transcribe файл.mp4" >&2
    return 2
  }

  srt="$(
    python3 - "$source_dir" "$russian" <<'PYSRT'
