spec = importlib.util.spec_from_file_location(
    "seminartext_topics",
    module_path,
)
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)

items = m.parse_srt(srt)
windows = m.make_windows(items)

cases = []

for number in window_numbers:
    if number < 1 or number > len(windows):
        print(
            f"[ПРЕДУПРЕЖДЕНИЕ] окно {number} отсутствует; "
            f"всего окон: {len(windows)}",
            file=sys.stderr,
        )
        continue

    window = windows[number - 1]

    segments = []
    for x in window:
        segments.append({
            "id": x["id"],
            "start": x["start"],
            "end": x["end"],
            "text": x["text"],
        })

    cases.append({
        "case_id": f"{source_id}_window_{number:02d}",
        "source_id": source_id,
        "window_number": number,
        "start": window[0]["start"],
        "end": window[-1]["end"],
        "first_segment_id": window[0]["id"],
        "last_segment_id": window[-1]["id"],
        "segments": segments,

        "gold": {
            "boundaries": [],
            "topics": []
        },

        "review": {
            "status": "needs_manual_label",
            "notes": ""
        }
    })

benchmark = {
    "schema_version": 1,
    "type": "seminartext_topic_benchmark",
    "source_id": source_id,
    "window_count": len(cases),
    "cases": cases,
}

json_out.write_text(
    json.dumps(
        benchmark,
        ensure_ascii=False,
        indent=2,
    ) + "\n",
    encoding="utf-8",
)

md = [
    "# SeminarText Topic Benchmark",
    "",
    f"Источник: `{source_id}`",
    "",
    "Для каждого кейса вручную определите:",
    "",
    "1. реальные смысловые границы;",
    "2. название каждой темы;",
    "3. при необходимости краткое примечание.",
    "",
]

for case in cases:
    md += [
        "---",
        "",
        f"## {case['case_id']}",
        "",
        f"Время: {case['start']}–{case['end']}",
        "",
        "### Эталон",
        "",
        "Границы:",
        "",
        "```text",
        "",
        "```",
        "",
        "Темы:",
        "",
        "```text",
        "",
        "```",
        "",
        "### Расшифровка",
        "",
    ]

    for seg in case["segments"]:
        md.append(
            f'[{seg["id"]}] {seg["start"]}–{seg["end"]} | {seg["text"]}'
        )

    md.append("")

md_out.write_text(
    "\n".join(md).rstrip() + "\n",
    encoding="utf-8",
)

print("TOPIC BENCHMARK СОЗДАН")
print()
print(f"Кейсов: {len(cases)}")
for case in cases:
    print(
        f'  {case["case_id"]}: '
        f'{case["start"]}–{case["end"]}'
    )
print()
print(f"JSON: {json_out}")
print(f"REVIEW: {md_out}")
PYBENCH
}

