      printf '%3d. %s [%s]\n     %s\n' "$i" "$title" "$source" "$path"
    done < "$q"
    rm -f "$q"
    exit 0
  fi

  while IFS= read -r record; do
    path="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["path"])' "$record")"
