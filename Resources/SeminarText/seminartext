        echo "SRT создан, но режим --burn недоступен." >&2
        return 3
      fi

      target="$(dirname "$input")/${stem}_subtitled.mp4"
      if [[ -e "$target" && "$FORCE" -eq 0 ]]; then
        echo "Готовое видео с субтитрами уже существует, используется повторно: $target"
        return 0
      fi

      subtitle_tmp="$(mktemp -d "${TMPDIR:-/tmp}/seminartext-subtitles.XXXXXX")"
      normalize_srt_for_ffmpeg "$output" "$subtitle_tmp/subtitles.srt"
      "$burn_ffmpeg" -hide_banner -y -i "$input" \
        -vf "subtitles=$subtitle_tmp/subtitles.srt" \
        -c:v libx264 -preset medium -crf 18 -c:a copy "$target"
      rm -rf "$subtitle_tmp"

      [[ -s "$target" ]] || {
