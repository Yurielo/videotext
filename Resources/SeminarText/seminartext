doctor() {
  resolve_models
  echo "SeminarText $VERSION"
  echo
  local bad=0 p
  for p in python3 ffmpeg ffprobe whisper-cli; do
    if command -v "$p" >/dev/null 2>&1; then
      echo "[OK] $p: $(command -v "$p")"
    else
      echo "[НЕТ] $p"
      bad=1
    fi
  done
  echo
  echo "Python-модули SeminarText:"

  if [[ -x "$SEMINARTEXT_PYTHON" ]]; then
    echo "[OK] SeminarText Python: $SEMINARTEXT_PYTHON"

    if "$SEMINARTEXT_PYTHON" -c 'import pptx' >/dev/null 2>&1; then
      echo "[OK] python-pptx"
    else
      echo "[НЕТ] python-pptx"
      bad=1
    fi

    if "$SEMINARTEXT_PYTHON" -c 'import pymupdf' >/dev/null 2>&1; then
      echo "[OK] PyMuPDF"
    else
      echo "[НЕТ] PyMuPDF"
      bad=1
    fi
  else
    echo "[НЕТ] Python-окружение SeminarText:"
    echo "      $SEMINARTEXT_PYTHON"
    bad=1
  fi

  echo

  if command -v pandoc >/dev/null 2>&1; then
    echo "[OK] pandoc: $(command -v pandoc)"
  else
    echo "[ПРЕДУПРЕЖДЕНИЕ] pandoc не найден — DOCX не будет создан"
  fi
  if command -v yt-dlp >/dev/null 2>&1; then
    echo "[OK] yt-dlp: $(command -v yt-dlp)"
  else
    echo "[ПРЕДУПРЕЖДЕНИЕ] yt-dlp не найден — YouTube-ссылки недоступны (brew install yt-dlp)"
  fi
  if [[ -n "$MODEL" && -f "$MODEL" ]]; then
    echo "[OK] Whisper model: $MODEL"
  else
    echo "[НЕТ] ggml-large-v3.bin"
    bad=1
  fi
  if [[ -n "$VAD_MODEL" && -f "$VAD_MODEL" ]]; then
    echo "[OK] VAD model: $VAD_MODEL"
  else
    echo "[НЕТ] ggml-silero-v5.1.2.bin"
    bad=1
  fi
  mkdir -p "$TRANSCRIPTS_ROOT" 2>/dev/null || true
  if [[ -d "$TRANSCRIPTS_ROOT" && -w "$TRANSCRIPTS_ROOT" ]]; then
    echo "[OK] Папка результатов: $TRANSCRIPTS_ROOT"
  else
    echo "[НЕТ ДОСТУПА] $TRANSCRIPTS_ROOT"
    bad=1
  fi
  return "$bad"
}

sanitize_name() {
  local s="$1"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/ }"
  s="${s//\//-}"
  s="${s//:/-}"
  while [[ "$s" == *"  "* ]]; do s="${s//  / }"; done
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  [[ -n "$s" ]] || s="Расшифровка"
  printf '%s\n' "$s"
}

is_youtube_url() {
  [[ "$1" =~ ^https?://([^/]+\.)?(youtube\.com|youtu\.be)(/|$) ]]
}

download_youtube_audio() {
  local url="$1" dir="$2" log="$3" out="" status=1
  command -v yt-dlp >/dev/null 2>&1 || {
    echo "Ошибка: для YouTube требуется yt-dlp. Установите: brew install yt-dlp" >&2
    return 1
  }

  rm -f "$dir"/.youtube_source.* 2>/dev/null || true
  local ytdlp_help=""
  ytdlp_help="$(yt-dlp --help 2>/dev/null || true)"

  local args=(--ignore-config --no-playlist -f "bestaudio/best" -x --audio-format m4a --audio-quality 0 -o "$dir/.youtube_source.%(ext)s")
  [[ "$ytdlp_help" == *"--force-ipv4"* ]] && args+=(--force-ipv4)
  [[ "$ytdlp_help" == *"--http-chunk-size"* ]] && args+=(--http-chunk-size 10M)

  if [[ -n "${SEMINARTEXT_YTDLP_COOKIES_FROM_BROWSER:-}" ]]; then
    [[ "$ytdlp_help" == *"--cookies-from-browser"* ]] || {
      echo "Ошибка: установленный yt-dlp не поддерживает --cookies-from-browser." >&2
      return 1
    }
    args+=(--cookies-from-browser "$SEMINARTEXT_YTDLP_COOKIES_FROM_BROWSER")
  fi

  echo "Скачиваю аудиодорожку YouTube..." | tee -a "$log" >&2
  local -a attempt_args
  attempt_args=("${args[@]}")

  set +e
  yt-dlp "${attempt_args[@]}" "$url" 2>&1 | tee -a "$log" >&2
  status=${PIPESTATUS[0]}
  set -e

  if (( status != 0 )) && [[ "$ytdlp_help" == *"--extractor-args"* ]]; then
    echo "yt-dlp не смог скачать аудио; повторяю с YouTube client fallback..." | tee -a "$log" >&2
    rm -f "$dir"/.youtube_source.* 2>/dev/null || true
    attempt_args=("${args[@]}" --extractor-args "youtube:player_client=android,web")
    set +e
    yt-dlp "${attempt_args[@]}" "$url" 2>&1 | tee -a "$log" >&2
    status=${PIPESTATUS[0]}
    set -e
  fi

  if (( status != 0 )); then
    echo "Ошибка: yt-dlp не смог скачать аудиодорожку YouTube. Если видео доступно только через браузерную сессию, задайте SEMINARTEXT_YTDLP_COOKIES_FROM_BROWSER." >&2
    return "$status"
  fi

  out="$(find "$dir" -maxdepth 1 -type f -name '.youtube_source.*' | head -n1)"
  [[ -n "$out" && -s "$out" ]] || {
    echo "Ошибка: yt-dlp завершился, но аудиофайл не найден." >&2
    return 1
  }
  printf '%s\n' "$out"
}

parse_args() {
  while (($#)); do
    case "$1" in
      doctor) doctor; exit $? ;;
      --careful) MODE="careful" ;;
      --language)
        shift
        (($#)) || { echo "Ошибка: после --language укажите ru или en." >&2; exit 2; }
        case "$1" in
          ru|en) SOURCE_LANGUAGE="$1" ;;
          *) echo "Ошибка: неподдерживаемый язык '$1'. Допустимые значения: ru, en." >&2; exit 2 ;;
        esac
        ;;
      --language=*)
        case "${1#*=}" in
          ru|en) SOURCE_LANGUAGE="${1#*=}" ;;
          *) echo "Ошибка: неподдерживаемый язык '${1#*=}'. Допустимые значения: ru, en." >&2; exit 2 ;;
        esac
        ;;
      --structured-timing) STRUCTURED_TIMING=1 ;;
      --force) FORCE=1 ;;
      --list) LIST_ONLY=1 ;;
      --no-open) OPEN_RESULTS=0 ;;
      -h|--help) show_help; exit 0 ;;
      -v|--version) echo "seminartext $VERSION"; exit 0 ;;
      --) shift; while (($#)); do INPUTS+=("$1"); shift; done; break ;;
      -*) echo "Неизвестный параметр: $1" >&2; show_help; exit 2 ;;
      *) INPUTS+=("$1") ;;
    esac
    shift
  done
}

build_queue() {
  local q
  q="$(mktemp -t seminartext_queue.XXXXXX)"
  python3 - "$q" "${INPUTS[@]}" <<'PY'
import json
import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse, parse_qs

out = Path(sys.argv[1])
raw_inputs = sys.argv[2:]
audio = {'.m4a', '.mp3', '.wav', '.aac', '.flac', '.ogg', '.opus'}
video = {'.mp4', '.mov', '.mkv', '.avi', '.webm', '.m4v'}
media = audio | video
ignored_names = {
    'audio record', 'audio records', 'audio_record', 'audio_records',
    'separate audio', 'separate_audio', 'individual audio', 'individual_audio',
    'participants', 'participant audio', 'participant_audio',
    'chat', 'transcripts', 'transcript'
}
seen = set()
records = []

def is_youtube_url(value: str) -> bool:
    try:
        host = (urlparse(value).hostname or '').lower()
    except Exception:
        return False
    return host == 'youtu.be' or host == 'youtube.com' or host.endswith('.youtube.com')

def fallback_title(url: str) -> str:
    p = urlparse(url)
    vid = ''
    if (p.hostname or '').lower() == 'youtu.be':
        vid = p.path.strip('/').split('/')[0]
    else:
        vid = (parse_qs(p.query).get('v') or [''])[0]
        if not vid and p.path.startswith('/shorts/'):
            vid = p.path.split('/shorts/', 1)[1].split('/')[0]
    return 'YouTube ' + (vid or 'video')

def youtube_title(url: str) -> str:
    try:
        r = subprocess.run(
            ['yt-dlp', '--ignore-config', '--no-playlist', '--skip-download',
             '--print', '%(title)s', url],
            capture_output=True, text=True, timeout=60, check=False
        )
        title = (r.stdout or '').splitlines()[0].strip() if r.stdout else ''
        return title or fallback_title(url)
    except Exception:
        return fallback_title(url)

def file_size(path: Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0

def is_ignored_dir(path: Path) -> bool:
    return any(part.lower() in ignored_names for part in path.parts)

def choose_recording(directory: Path):
    try:
        files = [
            p for p in directory.iterdir()
            if p.is_file() and p.suffix.lower() in media and not p.name.startswith('.')
        ]
    except OSError:
        return None

    exact = [p for p in files if p.name.lower() == 'audio_only.m4a']
    if exact:
        return max(exact, key=file_size)

    audios = [p for p in files if p.suffix.lower() in audio]
    if audios:
        return max(audios, key=file_size)

    videos = [p for p in files if p.suffix.lower() in video]
    return max(videos, key=file_size) if videos else None

def add(key: str, title: str, source_type: str):
    if key in seen:
        return
    seen.add(key)
    records.append({'path': key, 'title': title, 'source': source_type})

for raw in raw_inputs:
    if is_youtube_url(raw):
        add(raw, youtube_title(raw), 'YouTube')
        continue

    if raw.startswith(('http://', 'https://')):
        print(f'Неподдерживаемая ссылка: {raw}', file=sys.stderr)
        continue

    source = Path(raw).expanduser()
    if not source.exists():
        print(f'Не найдено: {source}', file=sys.stderr)
        continue

    if source.is_file():
        if source.suffix.lower() in media:
            add(str(source.resolve()), source.stem, 'файл')
        else:
            print(f'Неподдерживаемый файл: {source}', file=sys.stderr)
        continue

    directories = []
    for root, names, filenames in os.walk(source):
        names[:] = [
            n for n in names
            if n.lower() not in ignored_names and not n.startswith('.')
        ]
        directory = Path(root)
        if is_ignored_dir(directory):
            continue
        if any(Path(name).suffix.lower() in media and not name.startswith('.') for name in filenames):
            directories.append(directory)

    for directory in sorted(set(directories), key=lambda p: str(p).lower()):
        recording = choose_recording(directory)
        if recording:
            add(str(recording.resolve()), directory.name, 'папка Zoom')

with out.open('w', encoding='utf-8') as handle:
    for record in records:
        handle.write(json.dumps(record, ensure_ascii=False) + '\n')
PY
  printf '%s\n' "$q"
}

clean_text() {
  python3 - "$1" "$2" "${3:-}" "${4:-ru}" <<'PY'
import collections
import re
import sys
from pathlib import Path

src = Path(sys.argv[1])
dst = Path(sys.argv[2])
report_path = Path(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3] else None
language = sys.argv[4]
text = src.read_text(encoding='utf-8', errors='replace')

FALSE_PHRASES = [
    r'продолжение следует', r'спасибо за просмотр', r'спасибо за внимание',
    r'субтитры сделал', r'субтитры подготов', r'редактор субтитров',
    r'подписывайтесь на канал', r'ставьте лайк'
] if language == 'ru' else []

REPLACEMENTS = {
    r'\bвсеоблимливающ(?:ий|ая|ее|ие|ими|их)\b': 'всеобъемлющие',
    r'\bпостепат(?:а|ом|у|ы|ов)?\b': 'остеопат',
    r'\bгрифрук(?:т|та|ту|том|те)?\b': 'грейпфрут',
    r'\bгрифрукт(?:а|у|ом|е|ы|ов)?\b': 'грейпфрут',
    r'\bадипол(?:ь|я|ю|ем|е)?\b': 'диполь',
    r'\bкиноэстетик(?:а|у|ом|е|и|ов)?\b': 'кинестетик',
    r'\bотсослать\b': 'отослать',
    r'\bпровождаются\b': 'сопровождаются',
    r'\bправа почки\b': 'правой почки',
} if language == 'ru' else {}

SUSPICIOUS = [
    'резонансный расход', 'динамического сапатического', 'тамуашеки',
    'можно в состав стола', 'подорваться за ручку', 'майтик',
    'весновидение', 'пальцы начинают тягаться', 'партиру двумя руками'
] if language == 'ru' else []

LANGUAGE_BOUNDARIES = {'камера мотор', 'голос за кадром'} if language == 'ru' else set()

def norm(s: str) -> str:
    s = s.lower().replace('ё', 'е')
    s = re.sub(r'[^0-9a-zа-я]+', ' ', s, flags=re.I)
    return re.sub(r'\s+', ' ', s).strip()

def apply_replacements(s: str) -> tuple[str, int]:
    total = 0
    for pattern, replacement in REPLACEMENTS.items():
        s, n = re.subn(pattern, replacement, s, flags=re.I)
        total += n
    return s, total

paragraphs = []
current = []
for raw in text.splitlines():
    line = re.sub(r'^\s*\[[^]]+-->[^]]+\]\s*', '', raw.strip())
    line = re.sub(r'\s+', ' ', line).strip()
    if not line:
        if current:
            paragraphs.append(' '.join(current)); current = []
        continue
    if any(re.match(r'^' + pattern, line, re.I) for pattern in FALSE_PHRASES):
        continue
    current.append(line)
if current:
    paragraphs.append(' '.join(current))

joined = '\n\n'.join(paragraphs)
sentences = [x.strip() for x in re.split(r'(?<=[.!?…])\s+', joined) if x.strip()]

cleaned = []
removed_exact = removed_blocks = removed_runaway = replacement_count = 0
seen_recent = collections.deque(maxlen=30)
occurrences = collections.Counter()

for sentence in sentences:
    sentence, nrep = apply_replacements(sentence)
    replacement_count += nrep
    key = norm(sentence)
    if not key:
        continue
    if cleaned and key == norm(cleaned[-1]) and len(cleaned) >= 2 and key == norm(cleaned[-2]):
        removed_exact += 1
        continue
    trial = cleaned + [sentence]
    block_removed = False
    for size in range(1, min(6, len(trial)//3) + 1):
        a = [norm(x) for x in trial[-size:]]
        b = [norm(x) for x in trial[-2*size:-size]]
        c = [norm(x) for x in trial[-3*size:-2*size]]
        if a == b == c:
            removed_blocks += 1
            block_removed = True
            break
    if block_removed:
        continue
    occurrences[key] += 1
    if len(key.split()) <= 12 and occurrences[key] > 3 and key in seen_recent:
        removed_runaway += 1
        continue
    cleaned.append(sentence)
    seen_recent.append(key)

out_paragraphs = []
buf = []
for sentence in cleaned:
    low = norm(sentence)
    boundary = low in LANGUAGE_BOUNDARIES or sentence.endswith(':') or len(buf) >= 6
    if boundary and buf:
        out_paragraphs.append(' '.join(buf)); buf = []
    buf.append(sentence)
    if low in LANGUAGE_BOUNDARIES:
        out_paragraphs.append(' '.join(buf)); buf = []
if buf:
    out_paragraphs.append(' '.join(buf))

dst.write_text('\n\n'.join(out_paragraphs).strip() + '\n', encoding='utf-8')

if report_path:
    lower = text.lower()
    suspicious_found = [(p, lower.count(p.lower())) for p in SUSPICIOUS if lower.count(p.lower())]
    lines = [
        'ОТЧЁТ ПРОВЕРКИ SEMINARTEXT', '', f'Исходный файл: {src}',
        f'Предложений до очистки: {len(sentences)}',
        f'Предложений после очистки: {len(cleaned)}',
        f'Удалено точных повторов: {removed_exact}',
        f'Удалено повторяющихся блоков: {removed_blocks}',
        f'Удалено зацикленных коротких реплик: {removed_runaway}',
        f'Выполнено безопасных словарных исправлений: {replacement_count}', '',
        'ФРАГМЕНТЫ ДЛЯ РУЧНОЙ ПРОВЕРКИ'
    ]
    lines += [f'- «{p}» — найдено {n} раз(а)' for p, n in suspicious_found] or ['- Явных подозрительных фраз из встроенного списка не найдено.']
    lines += ['', 'Примечание: неоднозначные фамилии и специальные термины без сверки с аудио автоматически не исправляются.']
    report_path.write_text('\n'.join(lines) + '\n', encoding='utf-8')
PY
}

