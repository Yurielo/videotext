import importlib.util
import json
import sys
from pathlib import Path

module_path = Path(sys.argv[1])
srt = Path(sys.argv[2])
source_id = sys.argv[3]
window_numbers = [
    int(x.strip())
    for x in sys.argv[4].split(",")
    if x.strip()
]
