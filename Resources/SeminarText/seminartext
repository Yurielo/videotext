print("HUMAN GATES")
human_gates = []


def collect_human_gates(node, prefix=""):
    if isinstance(node, dict):
        for key, item in node.items():
            path = f"{prefix}.{key}" if prefix else key
            if "human_gate" in key:
                human_gates.append((path, item))
            collect_human_gates(item, path)
    elif isinstance(node, list):
        for index, item in enumerate(node):
            collect_human_gates(item, f"{prefix}[{index}]")


