  )" || {
    echo "Ошибка: в папке расшифровки не найден transcriptN.srt." >&2
    return 2
  }

  base="$(basename "$input")"
  stem="${base%.*}"
  if [[ -z "$output" ]]; then
    output="$(dirname "$input")/${stem}_subtitles.srt"
  fi

  if [[ -e "$output" && "$FORCE" -eq 0 ]]; then
    echo "Готовый SRT уже существует, используется повторно: $output"
  else
    cp "$srt" "$output"
    [[ -s "$output" ]] || { echo "Ошибка: не удалось создать SRT." >&2; return 1; }
    echo "SRT ГОТОВ: $output"
