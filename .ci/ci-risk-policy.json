{
  "schemaVersion": 1,
  "policyVersion": "2026-10-11",
  "levelBExactPaths": [
    ".ci/ci-risk-policy.json",
    ".github/workflows/topic-regression.yml",
    "Package.resolved",
    "Package.swift",
    "Resources/Info.plist",
    "Tests/test_ci_cost_policy.py",
    "scripts/build_app.sh",
    "scripts/check_baseline.sh",
    "scripts/ci_risk_classifier.py",
    "scripts/dispatch_paid_macos_gate.py",
    "scripts/release_gate.sh",
    "scripts/test_ci_cost_policy.sh"
  ],
  "levelBPrefixes": [
    ".github/actions/",
    ".github/workflows/"
  ],
  "levelBExtensions": [
    ".a",
    ".dylib",
    ".entitlements",
    ".framework",
    ".so",
    ".xcconfig",
    ".xcframework",
    ".xcodeproj",
    ".xcworkspace"
  ],
  "knownRuntimeDiscoveryPaths": [
    "Sources/videotext/Adapters/MediaAdapters.swift",
    "Sources/videotext/Adapters/SpeechSynthesisAdapter.swift",
    "Sources/videotext/Services/Diagnostics.swift",
    "Sources/videotext/Services/ToolRunner.swift",
    "Sources/videotext/Services/WhisperModelLocator.swift"
  ],
  "ambiguousNewInfrastructureFileGlobs": [
    "Sources/videotext/Adapters/*",
    "Sources/videotext/Services/*Adapter*.swift",
    "Sources/videotext/Services/*Binary*.swift",
    "Sources/videotext/Services/*Executor*.swift",
    "Sources/videotext/Services/*Launcher*.swift",
    "Sources/videotext/Services/*Loader*.swift",
    "Sources/videotext/Services/*Locator*.swift",
    "Sources/videotext/Services/*Process*.swift",
    "Sources/videotext/Services/*Resolver*.swift",
    "Sources/videotext/Services/*Runner*.swift",
    "Sources/videotext/Services/*Runtime*.swift",
    "Sources/videotext/Services/*Tool*.swift"
  ],
  "newPresentationServiceGlobs": [
    "Sources/videotext/Services/*Presentation.swift"
  ],
  "levelAExactPaths": [
    ".gitignore",
    "AGENTS.md",
    "DEVELOPMENT_PLAN.md",
    "README.md",
    "scripts/check_agents.sh"
  ],
  "levelAPrefixes": [
    ".codex/agents/",
    "Resources/Branding/",
    "Resources/SeminarText/",
    "Sources/",
    "Tests/",
    "docs/"
  ],
  "levelAGlobs": [
    "Resources/*.icns",
    "Resources/AppIcon.iconset/*",
    "scripts/test_*.sh"
  ],
  "markerScanPrefixes": [
    "Resources/SeminarText/",
    "Sources/",
    "scripts/"
  ],
  "markerScanExcludedPrefixes": [
    "Tests/",
    "scripts/test_"
  ],
  "infrastructureMarkers": [
    {
      "code": "build-toolchain-marker",
      "pattern": "(?i)(xcodebuild|swiftc|MACOSX_DEPLOYMENT_TARGET|SDKROOT|ARCHS|VALID_ARCHS)"
    },
    {
      "code": "signing-notarization-marker",
      "pattern": "(?i)(codesign|notarytool|altool|CODE_SIGN|DEVELOPMENT_TEAM|PROVISIONING_PROFILE)"
    },
    {
      "code": "packaging-marker",
      "pattern": "(?i)(pkgbuild|productbuild|Contents/(MacOS|Resources)|CFBundleExecutable|CFBundleIdentifier)"
    },
    {
      "code": "runtime-discovery-marker",
      "pattern": "(?i)(/opt/homebrew|/usr/local|/(?:usr/)?s?bin|\\$\\{?HOME(?=\\}|[:%+\\-]|\\b)|~/|command -v|(?:shutil\\.)?which\\s*\\(|isExecutableFile|processInfo\\.environment|os\\.environ(?:\\.get\\s*\\(\\s*[\"']PATH[\"']|\\s*\\[\\s*[\"']PATH[\"'])|environment\\s*\\[\\s*[\"']PATH[\"']|getenv\\s*\\(\\s*[\"']PATH[\"']|Bundle\\.main|launchPath|executableURL|DYLD_|@rpath|dlopen\\()"
    },
    {
      "code": "shell-path-assignment-marker",
      "pattern": "(?m)^\\s*(?:export\\s+)?PATH\\s*=|\\benv\\s+PATH\\s*="
    },
    {
      "code": "shell-executable-selection-marker",
      "pattern": "(?im)(?:^\\s*(?:(?:local|declare|readonly)(?:\\s+-[A-Za-z]+)?\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*\\(|^\\s*(?:(?:local|declare|readonly)(?:\\s+-[A-Za-z]+)?\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*\\+=\\s*\\(\\s*(?:\\./|\\.\\./|tools/|/|\\$)|^\\s*(?:local\\s+(?:-a\\s+)?)?[A-Za-z_][A-Za-z0-9_]*(?:cli|binary|executable|tool|runner|launcher|wrapper|command)[A-Za-z0-9_]*\\s*=\\s*[\\\"']?[^\\n]*(?:/|\\$)[^\\n]*|^\\s*(?:exec\\s+)?[\\\"']?\\$[A-Za-z_][A-Za-z0-9_]*[\\\"']?(?:\\s|$))"
    },
    {
      "code": "shell-direct-exec-marker",
      "pattern": "(?m)(?:^|\\bthen\\s+|;\\s*)(?:exec\\s+)?(?:\\./|\\.\\./|tools/)"
    },
    {
      "code": "runtime-discovery-api-marker",
      "pattern": "(?is)(urlForApplication\\s*\\(|(?:applicationSupportDirectory|userDomainMask|NSHomeDirectory|homeDirectoryForCurrentUser)[\\s\\S]{0,512}(?:executable|binary|cli|tool|runner|launcher|wrapper)|(?:executable|binary|cli|tool|runner|launcher|wrapper)[\\s\\S]{0,512}(?:applicationSupportDirectory|userDomainMask|NSHomeDirectory|homeDirectoryForCurrentUser)|fileExists\\s*\\([\\s\\S]{0,512}(?:ffmpeg|ffprobe|whisper|ollama|seminartext|homebrew|(?:usr/)?s?bin|executable|binary|cli)|(?:ffmpeg|ffprobe|whisper|ollama|seminartext|homebrew|(?:usr/)?s?bin|executable|binary|cli)[\\s\\S]{0,512}fileExists\\s*\\()"
    },
    {
      "code": "runtime-launch-api-marker",
      "pattern": "(?i)(Process\\s*\\.\\s*(?:run|launch)|posix_spawn(?:p)?\\s*\\()"
    },
    {
      "code": "native-loading-api-marker",
      "pattern": "(?is)Bundle\\s*\\([^\\n]*\\)[^\\n]{0,256}\\.load\\s*\\("
    },
    {
      "code": "native-architecture-marker",
      "pattern": "(?i)(arm64|x86_64|lipo|Mach-O|install_name_tool|otool)"
    }
  ]
}
